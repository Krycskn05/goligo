{
"abfahren":[["أغادر في الساعة الثامنة.","متى تغادر غدًا؟","هو لا يغادر اليوم.","يوم الاثنين تغادر مبكرًا.","سيارة الأجرة تنطلق الآن.","نغادر يوم السبت.","هل تغادرون هذا المساء؟","يغادرون في الساعة التاسعة.","من أي رصيف تغادر حضرتك؟"],["غادرت بالقطار.","هل غادرت في الموعد؟","متى غادر اليوم؟","أمس غادرت في الساعة السابعة.","غادرت السفينة في الساعة العاشرة.","لم نغادر بعد.","هل غادرتم يوم الأحد؟","غادروا هذا الصباح.","متى غادرت حضرتك كولونيا؟"]],
"abgeben":[["أسلّم الواجبات اليوم.","هل تسلّم المفتاح؟","هو يسلّم الكتاب غدًا.","متى تسلّم الرسالة؟","الطفل يسلّم الدفتر.","لا نسلّم الاختبار بعد.","هل تسلّمون الاستمارة اليوم؟","يوم الجمعة يسلّمون الكتب.","أين تسلّم حضرتك الحقيبة؟"],["سلّمت الطرد بالفعل.","هل سلّمت الاختبار؟","هو لم يسلّم الدفتر.","أمس سلّمت ورقة الامتحان.","سلّم الطفل الرسمة.","سلّمنا السيارة يوم الاثنين.","أين سلّمتم السترات؟","هل تركوا الكلب عند الجدة؟","هل سلّمت حضرتك بطاقة هويتك؟"]],
"anbieten":[["أقدّم لك قهوة.","هل تقدّم للجدة شايًا؟","هو يقدّم لنا كعكة.","اليوم تقدّم للضيوف عصيرًا.","المقهى لا يقدّم فطورًا.","ماذا نقدّم للأطفال؟","أنتم تقدّمون لماكس كوبًا من الماء.","في الصيف يقدّمون المثلجات.","هل تقدّم حضرتك دورات في اللغة الألمانية أيضًا؟"],["قدّمت لآنا بيتزا.","هل قدّمت للجد كرسيًا؟","عرض عليّ مكانًا للجلوس.","أمس قدّمت لنا فاكهة.","عرض علينا الفندق غرفة.","لم نقدّم لتوم حساءً.","هل قدّمتم شيئًا للينا؟","عرضوا علينا المساعدة فورًا.","ماذا قدّمت حضرتك لضيفك؟"]],
"anfangen":[["أبدأ اليوم تعلّم الألمانية.","متى تبدأ العمل؟","هو يبدأ دائمًا في الموعد.","يوم الاثنين تبدأ المدرسة.","تبدأ الحفلة الموسيقية في الساعة الثامنة.","لا نبدأ بعد.","هل تبدؤون الأكل الآن؟","في يونيو يبدؤون دورة.","هل تبدأ حضرتك العمل عندنا يوم الاثنين؟"],["بدأت الكتاب أمس.","هل بدأت بالفعل؟","بدأ يلعب كرة القدم.","أمس بدأت مبكرًا.","بدأت المباراة في موعدها.","بدأنا في مايو.","لماذا لم تبدؤوا؟","بدؤوا قبل أسبوع.","متى بدأت حضرتك هنا؟"]],
"ankommen":[["أصل إلى برلين في الساعة العاشرة.","متى تصل إلى البيت؟","هو يصل دائمًا متأخرًا.","هل تصل غدًا بالقطار؟","يصل الطرد يوم الجمعة.","نصل إلى المحطة في الموعد.","لا تصلون قبل الساعة الثامنة.","في المساء يصلون إلى الفندق.","في أي ساعة تصل حضرتك؟"],["وصلت إلى فيينا بسلام.","متى وصلت أمس؟","لم يصل بعد.","وصلت يوم الأحد.","وصل التاكسي بالفعل.","وصلنا في الساعة الحادية عشرة.","هل وصلتم بسلام؟","وصلوا مساء أمس.","هل وصلت حضرتك بالحافلة؟"]],
"anrufen":[["أتصل بك هذا المساء.","هل تتصل بالجدة غدًا؟","هو يتصل بأمه كثيرًا.","كل يوم تتصل بأبيها.","الطفل يتصل بأمه.","لماذا لا نتصل بالطبيب؟","أنتم تتصلون بنا يوم الأحد.","غدًا يتصلون بالمدرسة.","هل تتصل بي حضرتك يوم الاثنين؟"],["اتصلت بلينا أمس.","بمن اتصلت؟","هو لم يتصل بي.","هذا الصباح اتصلت بالجد.","اتصل بنا المستشفى.","اتصلنا بالفندق.","هل اتصلتم بتوم بالفعل؟","أمس اتصلوا ثلاث مرات.","هل اتصلت بي حضرتك اليوم؟"]],
"anziehen":[["ألبس كنزة دافئة.","ماذا تلبس غدًا؟","هو لا يلبس سترة.","غدًا تلبس فستانًا.","الطفل يلبس الحذاء.","في الشتاء نلبس القفازات.","هل تلبسون معاطفكم؟","اليوم يلبسون الجينز.","هل تلبس حضرتك بدلة اليوم؟"],["لبست ملابسي بسرعة.","هل لبست قبعة؟","لبس القميص الجديد.","أمس لم تلبس جوارب.","لبس الطفل ملابسه وحده.","لبسنا ملابس دافئة.","ماذا لبستم للحفلة؟","اليوم لبسوا الأحذية الطويلة.","أي حذاء لبست حضرتك؟"]],
"aufstehen":[["أنهض كل يوم في الساعة السادسة.","متى تنهض يوم الأحد؟","هو لا يحب النهوض من السرير.","اليوم تنهض في الساعة الخامسة.","الطفل ينهض كثيرًا في الليل.","في عطلة نهاية الأسبوع ننهض متأخرين.","هل تنهضون الآن أخيرًا؟","في الصيف ينهضون مبكرًا جدًا.","هل تنهض حضرتك مبكرًا يوم السبت أيضًا؟"],["للأسف نهضت متأخرًا جدًا.","هل نهضت بالفعل؟","نهض في الساعة السادسة والنصف.","اليوم لم تنهض من السرير.","نهضت البنت فورًا.","نهضنا في الساعة الرابعة.","لماذا نهضتم مبكرًا هكذا؟","أمس نهضوا عند الظهر.","في أي ساعة نهضت حضرتك؟"]],
"aussehen":[["هل أبدو جيدًا؟","تبدو جميلًا جدًا اليوم.","هو يشبه أباه.","اليوم تبدو متعبة جدًا.","يبدو الطعام لذيذًا.","لا نبدو كإخوة.","لماذا تبدون حزينين هكذا؟","معًا يبدون سعداء جدًا.","حضرتك تبدو بحالة جيدة جدًا اليوم."],["بدوت كبيرًا في السن في الصورة.","كيف كان شكلك وأنت طفل؟","بدا مريضًا قليلًا.","أمس لم تبدُ بخير.","بدت الغرفة رائعة.","بدونا مثل السياح.","هل كان شكلكم مختلفًا من قبل؟","في المساء بدوا متعبين.","حضرتك بدوت أصغر سنًّا بالنظارة."]],
"aussteigen":[["أنزل عند المدرسة.","أين تنزل؟","ينزل عند مبنى البلدية.","غدًا تنزل في برلين.","الطفل ينزل من الخلف.","نحن لا ننزل هنا.","هل تنزلون الآن؟","في الساعة الثامنة ينزلون.","هل تنزل حضرتك في المحطة الرئيسية؟"],["لم أنزل بعد.","هل نزلت مبكرًا جدًا؟","نزل عند ساحة السوق.","أمس نزلت في كولونيا.","البنت نزلت من الأمام.","نزلنا عند المطار.","أين نزلتم؟","يوم الأحد نزلوا هنا.","هل نزلت حضرتك من التاكسي؟"]],
"ausziehen":[["لن أنتقل من البيت بعد.","متى تنتقل من البيت؟","ينتقل من بيت والديه.","الأسبوع القادم تنتقل من البيت.","الزوجان ينتقلان من البيت في الصيف.","ننتقل من البيت يوم السبت.","هل تنتقلون من البيت قريبًا؟","لماذا ينتقلون من البيت؟","هل تنتقل حضرتك من البيت في مايو؟"],["في السنة الماضية انتقلت من البيت.","هل انتقلت من البيت بالفعل؟","انتقل من بيت جدته.","أمس انتقلت من البيت.","البنت انتقلت من البيت في سن 18.","لم ننتقل من البيت.","هل انتقلتم من البيت يوم الجمعة؟","متى انتقلوا من البيت؟","هل انتقلت حضرتك من البيت الأسبوع الماضي؟"]],
"beginnen":[["غدًا أبدأ عملًا جديدًا.","متى تبدأ الدورة؟","يبدأ يومه بالقهوة.","الآن تبدأ واجباتها المدرسية.","الحفلة تبدأ في الساعة الثامنة مساءً.","لا نبدأ اليوم.","هل تبدؤون بالفعل؟","في الساعة التاسعة يبدؤون الدرس.","هل تبدأ حضرتك يوم الاثنين؟"],["لم أبدأ بعد.","هل بدأت الأكل؟","بدأ في الساعة السابعة.","اليوم بدأت الطبخ.","المباراة بدأت بالفعل.","بدأنا في يناير.","متى بدأتم؟","هل بدؤوا في الموعد؟","متى بدأت حضرتك تعلم الألمانية؟"]],
"bekommen":[["اليوم أستلم طردًا.","ماذا تحصل في عيد ميلادك؟","لا يحصل على جواب.","غدًا تحصل على دراجة.","الرضيع يأخذ الحليب.","غالبًا يزورنا ضيوف.","هل تحصلون على واجبات كثيرة؟","هل يستلمون بريدًا اليوم؟","ماذا تطلب حضرتك؟"],["استلمت بريدًا إلكترونيًا.","هل وصلتك رسالتي؟","أمس حصل على هدية.","هل حصلت على علامة جيدة؟","الطفل حصل على آيس كريم.","لم نحصل على تذاكر.","ماذا حصلتم في عيد الميلاد؟","في مايو رُزقوا بطفل.","هل استلمت حضرتك الفاتورة؟"]],
"bleiben":[["اليوم أبقى في البيت.","كم من الوقت تبقى؟","يبقى أسبوعين في هامبورغ.","يوم الأحد تبقى في السرير.","النافذة تبقى مفتوحة.","لا نبقى طويلًا.","هل تبقون للعشاء؟","اليوم يبقون عند الجدة.","هل تبقى حضرتك لحظة أخرى؟"],["اليوم بقيت في المكتب.","هل بقيت طويلًا في الحفلة؟","لماذا لم يبقَ؟","أمس بقيت عند آنا.","المقهى بقي مغلقًا.","بقينا ثلاثة أيام في روما.","هل بقيتم حتى النهاية؟","في المساء بقوا عندنا.","هل بقيت حضرتك في الفندق؟"]],
"bringen":[["أحضر لك قهوة.","هل توصل الأطفال إلى المدرسة؟","يحضر للجدة زهورًا.","اليوم تحضر كعكة.","التاكسي يوصلنا إلى المحطة.","اليوم لا نحضر مشروبات.","ماذا تحضرون إلى الحفلة؟","يوم الاثنين يحضرون الكنبة.","هل تحضر لي حضرتك ماءً من فضلك؟"],["أحضرت خبزًا.","هل أحضرت الكتاب؟","أوصلني إلى البيت.","هل أخذت الطرد إلى البريد؟","الطفل أحضر رسمة.","لم نحضر هدايا.","هل وضعتم الأطفال في السرير؟","اليوم أحضروا بيتزا.","إلى أين أخذت حضرتك السيارة؟"]],
"denken":[["أفكر كثيرًا في جدتي.","بمن تفكر؟","لا يفكر إلا في كرة القدم.","كل يوم تفكر في عائلتها.","الطفل يفكر في عيد الميلاد.","نفكر في الإجازة.","هل تتذكرون الواجبات؟","اليوم لا يفكرون في العمل.","هل تفكر حضرتك كثيرًا في أولادك؟"],["فكرت فيك.","هل تذكرت الحليب؟","لم يتذكر الموعد.","أمس فكرت في أبيها.","البنت فكرت في كل شيء.","فكرنا فيكم كثيرًا.","هل تذكرتم التذاكر؟","ماذا ظنوا؟","هل تذكرت حضرتك جواز سفرك؟"]],
"einladen":[["أدعوك إلى العشاء.","من تدعو إلى الحفلة؟","يدعو أصدقاءه.","اليوم تدعو آنا إلى القهوة.","الطفل يدعو خمسة أصدقاء.","لا ندعو ماكس.","هل تدعون لينا أيضًا؟","يوم السبت يدعون الجيران.","هل تدعو حضرتك زملاءك؟"],["دعوت الصف كله.","هل دعوت توم؟","دعاني إلى السينما.","أمس دعتنا.","البنت دعت جدها.","لم ندعُ أشخاصًا كثيرين.","من دعوتم؟","هل دعوك أيضًا؟","هل دعوت حضرتك عائلتك؟"]],
"empfehlen":[["أنصحك بالشوربة.","بماذا تنصحني؟","لا ينصح بالمطعم.","اليوم تنصح بالسمك.","الفندق ينصح بسيارة أجرة.","ننصح بالمقهى عند السوق.","هل تنصحون بالفيلم؟","هل ينصحون بالقطار؟","بماذا تنصح حضرتك اليوم؟"],["نصحت آنا بطبيب.","هل نصحتني بالكتاب؟","نصحنا بالبيتزا.","أمس نصحتني بالشاي.","وكالة السفر نصحت بروما.","لم ننصح بالسينما.","بماذا نصحتم ماكس؟","هل نصحوك بالدورة؟","أي فندق نصحت به حضرتك؟"]],
"essen":[["أحب أكل المعكرونة.","ماذا تأكل في الفطور؟","لا يأكل اللحم.","في الظهر تأكل في المقصف.","الرضيع يحب أكل الموز.","يوم الأحد نأكل عند الجدة.","هل تأكلون اليوم في المطعم؟","في المساء يأكلون البيتزا غالبًا.","هل تحب حضرتك أكل السمك؟"],["أكلت شوكولاتة كثيرة جدًا.","هل أكلت؟","أكل تفاحة.","أمس أكلت الشوربة.","الطفل لم يأكل الخضار.","أكلنا في الحديقة.","ماذا أكلتم أمس؟","هل أكلوا الكعكة كلها؟","هل أكلت حضرتك جيدًا؟"]],
"fahren":[["أذهب اليوم بالحافلة.","هل تسافر إلى برلين غدًا؟","يوم الاثنين يذهب إلى العمل.","هل تذهب بالدراجة كثيرًا؟","سيارة الأجرة تذهب إلى المحطة.","نذهب إلى البحر في عطلة نهاية الأسبوع.","متى تذهبون إلى البيت؟","اليوم لا يذهبون إلى المدينة.","هل تذهب حضرتك بالمترو؟"],["لم أذهب بسيارة الأجرة.","هل سافرت بالقطار؟","الأسبوع الماضي ذهب إلى جدته.","هل ذهبت إلى المدرسة وحدها؟","ذهب الطفل بالدراجة.","يوم الأحد ذهبنا إلى البحيرة.","إلى أين ذهبتم في العطلة؟","في المساء ذهبوا إلى البيت.","هل سافرت حضرتك إلى فيينا أمس؟"]],
"finden":[["لا أجد مفتاحي.","ما رأيك في الكتاب؟","يرى أن الشقة غالية جدًا.","هل يعجبها الفيلم؟","يجد الطفل يورو واحدًا.","اليوم لا نجد موقفًا للسيارة.","هل تجدون الألمانية صعبة؟","يجدون قطة في الحديقة.","هل تجد حضرتك الطريق إلى المحطة؟"],["وجدت شقة.","هل وجدت نظارتك؟","أخيرًا وجد عملًا.","وجدت هاتفًا في الحافلة.","وجدت البنت القطة.","لم نجد الفندق.","أين وجدتم الكلب؟","يوم الاثنين وجدوا المال.","هل وجدت حضرتك جواز سفرك؟"]],
"fliegen":[["أسافر بالطائرة إلى إسبانيا في الصيف.","إلى أين تسافر بالطائرة في العطلة؟","غدًا يسافر بالطائرة إلى باريس.","هل تسافر بالطائرة إلى لندن اليوم؟","تقلع الطائرة في الساعة الثامنة.","لا نحب السفر بالطائرة.","هل تسافرون بالطائرة إلى فيينا يوم الجمعة؟","في الشتاء يسافرون بالطائرة إلى إيطاليا.","هل تسافر حضرتك كثيرًا بالطائرة إلى برلين؟"],["سافرت أمس بالطائرة إلى هامبورغ.","هل سافرت بالطائرة من قبل؟","في مايو سافر بالطائرة إلى كندا.","أمس سافرت بالطائرة إلى مدريد.","طارت الطائرة إلى القاهرة.","لم نسافر بالطائرة هذه السنة.","متى عدتم بالطائرة إلى البيت؟","هل سافروا معًا بالطائرة إلى برلين؟","كم استغرقت رحلة حضرتك بالطائرة؟"]],
"geben":[["لا أعطيك هاتفي.","هل تعطيني الملح من فضلك؟","يعطي الطفل تفاحة.","اليوم تقيم حفلة.","هل يوجد سوبرماركت هنا؟","نعطي الجدة الزهور.","ماذا تعطون ماكس في عيد ميلاده؟","غدًا يقيمون حفلة موسيقية.","حضرتك تعطيني مالًا أكثر من اللازم."],["أعطيت أمي هدية.","هل أعطيت توم رقمك؟","أمس لم يعطني أي مال.","ماذا أعطتك؟","أمس كان هناك بيتزا.","أعطينا الكلب ماءً.","هل أعطيتم المعلم الدفتر؟","في المقهى أعطونا كعكًا.","لمن أعطيت حضرتك المفتاح؟"]],
"gefallen":[["تعجبني المدينة كثيرًا.","هل تعجبك الشقة الجديدة؟","لا يعجبه الفيلم.","يعجبها الحذاء الأحمر.","تعجب اللعبة الطفل.","تعجبنا الحديقة كثيرًا.","كيف تجدون برلين؟","الآن تعجبهم المدرسة.","هل تعجب حضرتك الموسيقى؟"],["أعجبتني العطلة كثيرًا.","هل أعجبك الحفل الموسيقي؟","أعجبته الحفلة كثيرًا.","هل أعجبتها الهدية؟","أعجب الكتاب الطفل.","لم يعجبنا الفندق.","كيف وجدتم الرحلة؟","أمس أعجبتهم حديقة الحيوانات كثيرًا.","هل أعجب حضرتك الطعام؟"]],
"gehen":[["أذهب اليوم إلى السينما.","هل تذهب إلى المدرسة غدًا؟","في الساعة العاشرة يذهب إلى السرير.","اليوم لا تذهب إلى العمل.","كيف حالك؟","نذهب للتسوق يوم السبت.","هل تذهبون كثيرًا إلى الحديقة؟","في المساء يذهبون إلى المطعم.","هل تمشي حضرتك إلى المحطة؟"],["ذهبت أمس إلى الطبيب.","متى ذهبت إلى البيت؟","لم يذهب إلى الحفلة.","يوم الأحد ذهبت للسباحة.","ذهب الطفل إلى الحديقة.","أمس ذهبنا إلى المتحف.","هل تمشيتم معًا؟","بعد ذلك ذهبوا إلى المقهى.","هل ذهبت حضرتك للتسوق بالفعل؟"]],
"gelten":[["التذكرة صالحة لي أيضًا.","هل البطاقة صالحة لك أيضًا؟","القاعدة لا تنطبق عليه.","سعر الأطفال ينطبق عليها.","القاعدة تنطبق على الطفل أيضًا.","التذاكر صالحة لنا جميعًا.","ما القواعد التي تنطبق عليكم؟","تنطبق عليهم أسعار أخرى.","السعر صالح لحضرتك أيضًا اليوم."],["كانت القاعدة تنطبق عليّ أيضًا.","هل كانت التذكرة صالحة لك؟","العرض لم يكن صالحًا له.","هل كان السعر ينطبق عليها أيضًا؟","كانت البطاقة صالحة للطفل.","في مايو كانت التذكرة صالحة لنا.","أي سعر كان ينطبق عليكم؟","كانت تنطبق عليهم قواعد أخرى.","هل كانت البطاقة صالحة لحضرتك فقط؟"]],
"heißen":[["اسمي آنا.","ما اسمك؟","اسمه ليس ماكس.","الآن اسمها بيكر.","اسم الطفل الرضيع توم.","اسمانا ماكس ولينا.","ما اسم عائلتكم؟","هل اسم كلتيهما آنا؟","ما اسم حضرتك؟"],["كان اسمي سابقًا شميت.","ألم يكن اسمك توم؟","ماذا كان اسمه؟","حتى مايو كان اسمها فاغنر.","ما كان اسم الكتاب؟","لم يكن اسمنا هكذا دائمًا.","هل كان اسم عائلتكم مولر سابقًا؟","في ذلك الوقت كان اسمهم ماير.","ما كان اسم حضرتك سابقًا؟"]],
"herunterladen":[["أقوم بتنزيل التطبيق.","هل تنزّل الصورة؟","ينزّل الموسيقى كل يوم.","اليوم تنزّل فيلمًا.","الهاتف ينزّل الصور.","لا ننزّل ألعابًا.","ماذا تنزّلون هناك؟","في المساء ينزّلون الصور.","من أين تنزّل حضرتك التذكرة؟"],["نزّلت الكتاب.","هل نزّلت الفيديو؟","نزّل قاموسًا.","هل نزّلت جدول المواعيد؟","نزّل الطفل لعبة.","لم ننزّل أي تطبيق.","هل نزّلتم الأغاني؟","ثم نزّلوا التطبيق.","هل نزّلت حضرتك الصور؟"]],
"helfen":[["أساعد أمي في المطبخ.","هل تساعدني في الواجبات المدرسية؟","يوم السبت يساعد جده في الحديقة.","اليوم تساعد الجارة.","يساعد الطفل في الطبخ.","نساعدك بكل سرور.","لماذا لا تساعدون توم؟","في عطلة نهاية الأسبوع يساعدون في المقهى.","حضرتك تساعدني كثيرًا حقًا."],["ساعدت أبي في التنظيف.","من ساعدت أمس؟","لم يساعدني.","أمس ساعدت المعلم.","ساعد الدواء بسرعة.","ساعدنا الجيران.","هل ساعدتم آنا في حمل الحقيبة؟","لحسن الحظ ساعدونا.","هل ساعدت حضرتك والدتك؟"]],
"kennen":[["أعرف المعلم جيدًا.","هل تعرف أختي؟","هو لا يعرف المدينة.","هل هي تعرف الطريق إلى المحطة؟","الطفل يعرف أغاني كثيرة.","نعرف مطعمًا جيدًا.","من أين تعرفون توم؟","الآن يعرفون المعلمة الجديدة.","هل تعرف حضرتك هذا الشارع؟"],["لم أكن أعرف الرجل.","هل كنت تعرف الأغنية من قبل؟","كان يعرف كل الكلمات.","هل كانت تعرف الفيلم؟","كانت البنت تعرف الجواب.","كنا نعرف الفندق جيدًا.","من أين كنتم تعرفون الطريق؟","كانوا يعرفون هنا ناسًا كثيرين.","هل كنت حضرتك تعرف والدي؟"]],
"kommen":[["أنا من تركيا.","متى تأتي إلى البيت؟","هو لا يأتي إلى العمل اليوم.","هي تأتي غدًا بالحافلة.","سيولد الطفل في شهر مايو.","نأتي في الساعة الثامنة.","هل تأتون إلى الحفلة يوم السبت؟","يوم الأحد يأتون لتناول الطعام.","من أين حضرتك؟"],["جئت متأخرًا.","كيف وصلت إلى العمل؟","هو لم يأتِ إلى المدرسة.","أمس جاءت بالقطار.","وصل الطرد اليوم.","جئنا بالدراجة.","هل وصلتم إلى البيت بخير؟","جاؤوا في الساعة التاسعة.","متى أتيت حضرتك إلى برلين؟"]],
"laufen":[["أركض في الحديقة كل صباح.","هل تمشي إلى المدرسة؟","هو يركض بسرعة كبيرة.","يوم الأحد تركض عشرة كيلومترات.","الطفل لا يمشي بعد.","نمشي معًا إلى البيت.","إلى أين تركضون بهذه السرعة؟","اليوم يمشون إلى السوبرماركت.","هل تحب حضرتك الركض في الغابة؟"],["مشيت إلى المحطة.","هل ركضت اليوم؟","أمس لم يركض.","إلى أين ركضت هي؟","ركض الطفل إلى أمه.","مشينا في المدينة.","هل مشيتم حتى البحيرة؟","يوم السبت ركضوا في الحديقة.","هل مشيت حضرتك إلى العمل اليوم؟"]],
"leidtun":[["أنا آسف.","على ماذا أنت آسف؟","هو آسف حقًا على ذلك.","الآن هي آسفة.","الطفل آسف على ذلك.","نحن آسفون جدًا على ذلك.","ألستم آسفين على ذلك؟","هم أيضًا آسفون على ذلك.","هل حضرتك آسف؟"],["كنت آسفًا جدًا على ذلك.","ألم تكن آسفًا؟","أمس كان آسفًا.","هل كانت آسفة على ذلك؟","البنت كانت آسفة على ذلك.","كنا آسفين حقًا.","على ماذا كنتم آسفين؟","هم أيضًا كانوا آسفين على ذلك.","هل كنت حضرتك آسفًا على ذلك؟"]],
"leihen":[["أعيرك دراجتي.","هل تعيرني قلمك؟","هو لا يعير آنا هاتفه.","اليوم تعير توم كتابًا.","الطفل يعير لينا كرته.","نعير أبي سيارتنا.","هل تعيروننا كراسيكم؟","غدًا يعيرون أمي حقيبة سفر.","هل تعيرني حضرتك مظلتك من فضلك؟"],["أعرت ماكس قاموسي.","لمن أعرت كاميرتك؟","هو أقرضني عشرة يورو.","هل أعارتك سترتها؟","أعارتني البنت لعبة.","لم نُقرض لينا أي مال.","هل أعرتم أبي حقيبة الظهر؟","أمس أعاروني كتبًا.","هل أقرضته حضرتك المال؟"]],
"lesen":[["أقرأ في السرير كل مساء.","ماذا تقرأ الآن؟","هو لا يحب القراءة.","في الصباح تقرأ رسائلها الإلكترونية.","الطفل يقرأ جيدًا بالفعل.","نقرأ نصًا في الدورة.","هل تقرؤون رسالة ماما؟","يقرؤون الجريدة في القطار.","هل تحب حضرتك قراءة الكتب؟"],["لقد قرأت الرسالة بالفعل.","هل قرأت رسالتي؟","هو لم يقرأ التمرين.","أمس قرأت ثلاث صفحات.","قرأ الطفل قصة.","قرأنا الكتاب كله.","ماذا قرأتم في العطلة؟","في المساء قرؤوا لوقت طويل.","هل قرأت حضرتك الرسالة الإلكترونية؟"]],
"liegen":[["أنا مريض في السرير.","لماذا تستلقي على الأرض؟","هو لا يحب الاستلقاء في الشمس.","الآن هي مستلقية على الكنبة.","الهاتف على الطاولة.","يوم الأحد نستلقي في الحديقة.","هل تحبون الاستلقاء على الشاطئ؟","في الصيف يستلقون غالبًا عند البحيرة.","هل حضرتك مستلقٍ بشكل مريح؟"],["استلقيت في حوض الاستحمام.","هل كنت راقدًا في المستشفى؟","هو لم يبقَ في السرير طويلًا.","هل استلقت في الشمس لوقت طويل؟","أين كان الكتاب؟","أمس استلقينا على العشب.","هل استلقيتم على الشرفة؟","في العطلة استلقوا على شاطئ البحر.","كم من الوقت استلقيت حضرتك هناك؟"]],
"mitbringen":[["سأحضر معي كعكة.","ماذا ستحضر معك إلى الحفلة؟","هو لا يحضر عصيرًا اليوم.","غدًا تحضر جيتارها معها.","الطفل يحضر صديقًا معه.","نحضر معنا خبزًا وجبنًا.","هل تحضرون أطفالكم معكم؟","يوم الأحد يحضرون معهم زهورًا.","هل تحضر حضرتك كلبك معك؟"],["أحضرت لك شيئًا.","هل أحضرت المال معك؟","هو أحضر معه أرغفة صغيرة.","أمس أحضرت فاكهة.","أحضر الطفل صورة.","لم نحضر أي مشروبات.","ماذا أحضرتم من إيطاليا؟","يوم الجمعة أحضروا سلطة.","هل أحضرت حضرتك بطاقة هويتك؟"]],
"mitkommen":[["آتي معكم بكل سرور.","هل تأتي معنا إلى السينما؟","للأسف هو لا يأتي معنا.","غدًا تأتي هي أيضًا معنا.","الطفل يأتي معنا إلى الطبيب.","نأتي معكم إلى المحطة.","هل تأتون معنا إلى الحفل الموسيقي؟","يوم السبت يأتون معنا إلى السوق.","هل تأتي حضرتك معنا هذا المساء؟"],["أتيت معكم بكل سرور.","هل أتيت معهم إلى المتحف؟","هو أتى معنا للتسوق.","أمس أتت معنا إلى السينما.","الطفل الرضيع أتى معنا أيضًا.","أتينا معهم إلى مباراة كرة القدم.","هل أتيتم معهم إلى حديقة الحيوانات؟","يوم الاثنين لم يأتوا معنا.","هل أتيت حضرتك معهم إلى المدينة؟"]]
}
