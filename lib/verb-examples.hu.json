"wissen":[["Tudom a választ.","Tudod, hol van a pályaudvar?","Ő nem tudja, hány óra van.","Persze, hogy tudja.","A gyerek már sokat tud.","Tudjuk az utat.","Tudjátok, mikor kezdődik a tanfolyam?","Sajnos még nem tudják.","Ön tudja, hány óra van?"],["Ezt nem tudtam.","Tudtad ezt?","Ő tudta a választ.","Persze, hogy mindent tudott.","A gyerek tudta az utat.","Már régóta tudtuk.","Tudtátok ezt?","Előtte semmit sem tudtak.","Ön tudta ezt?"]],
"ziehen":[["Húzom a kötelet.","Berlinbe költözöl?","Ő nem költözik a városba.","Májusban Münchenbe költözik.","A ló húzza a kocsit.","Vidékre költözünk.","A szüleitekhez költöztök?","Nyáron a tengerpartra költöznek.","Kérem, húzza erősen!"],["Berlinbe költöztem.","Közös albérletbe költöztél?","Ő nem költözött Bécsbe.","Tavaly Rómába költözött.","A pár egy házba költözött.","Vidékre költöztünk.","Hová költöztetek?","Tavasszal a tengerpartra költöztek.","Ön a városba költözött?"]],
"zurückgeben":[["Visszaadom neked a könyvet.","Visszaadod nekem az esernyőt?","Ő nem adja vissza a pénzt.","Holnap visszaadja a kulcsot.","A gyerek visszaadja a labdát.","Ma visszavisszük a könyveket.","Visszaviszitek a bicikliket?","Hétfőn visszaviszik az autót.","Kérem, adja vissza az útlevelet."],["Visszaadtam az esernyőt.","Visszaadtad a könyvet?","Ő nem adta vissza a pénzt.","Tegnap visszavitte a DVD-t.","A gyerek visszaadta a labdát.","Visszaadtuk a kulcsokat.","Visszavittétek az autót?","Időben mindent visszaadtak.","Ön visszavitte a dzsekit?"]],
"zurückgehen":[["Gyorsan visszamegyek haza.","Visszamész a boltba?","Ő nem megy vissza az irodába.","Most visszamegy az autóhoz.","A gyerek visszamegy az iskolába.","Visszamegyünk a szállodába.","Ti gyalog mentek vissza?","Este visszamennek a faluba.","Kérem, menjen vissza."],["Gyalog mentem vissza.","Egyedül mentél vissza?","Ő nem ment vissza.","A tanfolyam után visszament.","A gyerek visszament a házba.","Gyorsan visszamentünk.","Visszamentetek a szállodába?","Ők később visszamentek.","Ön visszament az autóhoz?"]],
"zurückfahren":[["Holnap visszautazom haza.","Mikor utazol vissza?","Ő ma nem utazik vissza.","Busszal megy vissza.","A taxi üresen megy vissza.","Vonattal utazunk vissza.","Vasárnap utaztok vissza?","A nyaralás után visszautaznak.","Kérem, lassan vezessen vissza."],["Autóval mentem vissza.","Tegnap utaztál vissza?","Ő nem utazott vissza.","Este visszautazott.","A taxi visszament.","Biciklivel mentünk vissza.","Vonattal utaztatok vissza?","Későn utaztak haza.","Ön már visszautazott?"]],
"zurückkommen":[["Hat órakor jövök vissza.","Mikor jössz vissza?","Ő ma nem jön vissza.","Holnap jön vissza Párizsból.","A gyerek hazajön az iskolából.","Hamarosan visszajövünk.","Hétfőn jöttök vissza?","Augusztusban jönnek vissza.","Kérem, jöjjön vissza holnap."],["Tegnap jöttem vissza.","Szerencsésen visszaértél?","Ő nem jött vissza.","Későn jött haza.","A csomag visszajött.","Visszajöttünk a nyaralásról.","Már visszajöttetek?","Este jöttek vissza.","Ön szerencsésen visszaért?"]]
