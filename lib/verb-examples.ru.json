"helfen":[["Я помогаю маме на кухне.","Ты поможешь мне с домашним заданием?","В субботу он помогает дедушке в саду.","Сегодня она помогает соседке.","Ребёнок помогает готовить.","Мы охотно тебе помогаем.","Почему вы не помогаете Тому?","На выходных они помогают в кафе.","Вы мне очень помогаете."],["Я помог папе с уборкой.","Кому ты вчера помог?","Он мне не помог.","Вчера она помогла учителю.","Лекарство быстро помогло.","Мы помогли соседям.","Вы помогли Анне с чемоданом?","К счастью, они нам помогли.","Вы помогли своей маме?"]],
"kennen":[["Я хорошо знаю учителя.","Ты знаешь мою сестру?","Он не знает города.","Она знает дорогу на вокзал?","Ребёнок знает много песен.","Мы знаем хороший ресторан.","Откуда вы знаете Тома?","Теперь они знают новую учительницу.","Вы знаете эту улицу?"],["Я не знал этого мужчину.","Ты уже знал эту песню?","Он знал все слова.","Она знала этот фильм?","Девочка знала ответ.","Мы хорошо знали этот отель.","Откуда вы знали дорогу?","Здесь они знали много людей.","Вы знали моего отца?"]],
"kommen":[["Я из Турции.","Когда ты придёшь домой?","Он сегодня не придёт на работу.","Завтра она приедет на автобусе.","Ребёнок родится в мае.","Мы придём в восемь часов.","Вы придёте на вечеринку в субботу?","В воскресенье они придут на обед.","Откуда Вы?"],["Я пришёл слишком поздно.","Как ты добрался до работы?","Он не пришёл в школу.","Вчера она приехала на поезде.","Посылка пришла сегодня.","Мы приехали на велосипеде.","Вы хорошо добрались домой?","Они пришли в девять часов.","Когда Вы приехали в Берлин?"]],
"laufen":[["Я бегаю в парке каждое утро.","Ты ходишь в школу пешком?","Он бегает очень быстро.","В воскресенье она бежит десять километров.","Малыш ещё не ходит.","Мы вместе идём домой пешком.","Куда вы так быстро бежите?","Сегодня они идут в супермаркет пешком.","Вы любите бегать в лесу?"],["Я пошёл на вокзал пешком.","Ты уже бегал сегодня?","Вчера он не бегал.","Куда она побежала?","Ребёнок побежал к маме.","Мы гуляли по городу.","Вы дошли пешком до озера?","В субботу они бегали в парке.","Вы сегодня шли на работу пешком?"]],
"leidtun":[["Мне жаль.","О чём ты жалеешь?","Ему действительно жаль.","Теперь ей жаль.","Ребёнку жаль.","Нам очень жаль.","Вам не жаль?","Им тоже жаль.","Вам жаль?"],["Мне было очень жаль.","Тебе не было жаль?","Вчера ему было жаль.","Ей было жаль?","Девочке было жаль.","Нам правда было жаль.","О чём вы пожалели?","Им тоже было жаль.","Вам было жаль?"]],
"leihen":[["Я одолжу тебе свой велосипед.","Ты одолжишь мне свою ручку?","Он не одалживает Анне свой телефон.","Сегодня она одалживает Тому книгу.","Ребёнок даёт Лене свой мяч.","Мы одалживаем папе нашу машину.","Вы одолжите нам свои стулья?","Завтра они одолжат маме чемодан.","Вы одолжите мне, пожалуйста, свой зонт?"],["Я одолжил Максу свой словарь.","Кому ты одолжил свой фотоаппарат?","Он одолжил мне десять евро.","Она одолжила тебе свою куртку?","Девочка одолжила мне игру.","Мы не одолжили Лене денег.","Вы одолжили папе рюкзак?","Вчера они одолжили мне книги.","Вы одолжили ему деньги?"]],
"lesen":[["Я читаю в кровати каждый вечер.","Что ты сейчас читаешь?","Он не любит читать.","Утром она читает электронную почту.","Ребёнок уже хорошо читает.","На курсе мы читаем текст.","Вы читаете сообщение от мамы?","В поезде они читают газету.","Вы любите читать книги?"],["Я уже прочитал письмо.","Ты прочитал моё сообщение?","Он не прочитал задание.","Вчера она прочитала три страницы.","Ребёнок прочитал рассказ.","Мы прочитали всю книгу.","Что вы читали в отпуске?","Вечером они долго читали.","Вы прочитали электронное письмо?"]],
"liegen":[["Я лежу больной в постели.","Почему ты лежишь на полу?","Он не любит лежать на солнце.","Сейчас она лежит на диване.","Телефон лежит на столе.","В воскресенье мы лежим в саду.","Вы любите лежать на пляже?","Летом они часто лежат у озера.","Вам удобно лежать?"],["Я лежал в ванне.","Ты лежал в больнице?","Он недолго лежал в кровати.","Она долго лежала на солнце?","Где лежала книга?","Вчера мы лежали на траве.","Вы лежали на балконе?","В отпуске они лежали у моря.","Как долго Вы там лежали?"]],
"mitbringen":[["Я принесу торт.","Что ты принесёшь на вечеринку?","Сегодня он не принесёт сока.","Завтра она принесёт свою гитару.","Ребёнок приводит друга.","Мы принесём хлеб и сыр.","Вы приведёте своих детей?","В воскресенье они принесут цветы.","Вы возьмёте с собой свою собаку?"],["Я тебе кое-что принёс.","Ты принёс деньги?","Он принёс булочки.","Вчера она принесла фрукты.","Ребёнок принёс рисунок.","Мы не принесли напитков.","Что вы привезли из Италии?","В пятницу они принесли салат.","Вы принесли удостоверение личности?"]],
"mitkommen":[["Я с удовольствием пойду с вами.","Ты пойдёшь с нами в кино?","К сожалению, он не пойдёт с нами.","Завтра она тоже пойдёт с нами.","Ребёнок идёт с нами к врачу.","Мы пойдём с вами на вокзал.","Вы пойдёте с нами на концерт?","В субботу они пойдут с нами на рынок.","Вы пойдёте с нами сегодня вечером?"],["Я с удовольствием пошёл с вами.","Ты ходил с ними в музей?","Он пошёл с нами за покупками.","Вчера она ходила с нами в кино.","Малыш тоже поехал с нами.","Мы пошли с ними на футбольный матч.","Вы ходили с ними в зоопарк?","В понедельник они не пошли с нами.","Вы поехали с ними в город?"]]
}
