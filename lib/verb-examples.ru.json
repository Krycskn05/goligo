"umsteigen":[["Я делаю пересадку на главном вокзале.","Где ты делаешь пересадку?","Сегодня он не делает пересадку.","В Кёльне она пересаживается на ICE.","Команда пересаживается в Гамбурге.","Мы пересаживаемся на метро.","Вы пересаживаетесь во Франкфурте?","По дороге они дважды пересаживаются.","Пожалуйста, сделайте пересадку в Майнце."],["Я пересел в Мюнхене.","Ты пересел в Кёльне?","Он не пересел.","На вокзале она быстро пересела.","Команда пересела в Берлине.","Мы пересаживались два раза.","Где вы пересели?","В Базеле они пересели.","Вы пересели в Лейпциге?"]],
"umziehen":[["Я переезжаю на следующей неделе.","Когда ты переезжаешь?","В этом году он не переезжает.","В мае она переезжает в Берлин.","Офис переезжает в город.","Мы переезжаем в квартиру побольше.","Вы скоро переезжаете?","Летом они переезжают в Кёльн.","Вы тоже переезжаете?"],["Я переехал в прошлом месяце.","Ты уже переехал?","Он ещё не переехал.","В июне она переехала в Бонн.","Кафе переехало в старый город.","Мы переехали в Берлин.","Когда вы переехали?","Год назад они переехали.","Вы часто переезжали?"]],
"unterschreiben":[["Я подписываю договор.","Ты распишешься здесь?","Он пока это не подписывает.","Сегодня она подписывает письмо.","Ребёнок подписывается карандашом.","Мы подписываем договор аренды.","Вы подписываете бланк?","Завтра они подписывают все документы.","Распишитесь, пожалуйста, здесь."],["Я подписал договор.","Ты подписал бланк?","Он не подписал.","Сегодня она всё подписала.","Ребёнок подписал открытку.","Мы уже подписали.","Вы подписали список?","Вчера они подписали.","Вы подписали заявление?"]],
"vergessen":[["Я часто забываю ключ.","Ты никогда ничего не забываешь?","Он не забывает о своей встрече.","Она всегда забывает зонт.","Ребёнок забывает шапку.","Мы тебя не забываем.","Вы забываете домашнее задание?","Они часто забывают о времени.","Не забудьте свой паспорт!"],["Я забыл сумку.","Ты забыл о встрече?","Он не забыл о её дне рождения.","Сегодня она забыла телефон.","Ребёнок забыл куртку.","Мы забыли о времени.","Вы что-то забыли?","К сожалению, они забыли билет.","Вы забыли свои очки?"]],
"verlieren":[["Я часто теряю перчатки.","Ты не любишь проигрывать?","Он никогда не теряет терпения.","В теннис она проигрывает редко.","Команда проигрывает матч.","Мы не теряем времени.","Вы часто проигрываете в карты?","В лесу они сбиваются с пути.","Не падайте духом!"],["Я потерял кошелёк.","Ты потерял телефон?","Он не проиграл игру.","В автобусе она потеряла шарф.","У ребёнка выпал зуб.","Мы потеряли много времени.","Вы заблудились?","К сожалению, они проиграли финал.","Вы что-то потеряли?"]],
"verstehen":[["Теперь я понимаю задание.","Ты меня понимаешь?","Он не понимает по-английски.","По телефону она меня не понимает.","Ребёнок уже многое понимает.","Мы хорошо понимаем учителя.","Вы понимаете проблему?","Они понимают друг друга без слов.","Вы понимаете по-немецки?"],["Я всё понял.","Ты понял вопрос?","Он не понял шутку.","Она сразу поняла правило.","Ребёнок понял историю.","Мы поняли совсем немного.","Вы поняли упражнение?","Наконец они поняли игру.","Вы поняли моё имя?"]],
"wehtun":[["У меня болит голова.","У тебя болит живот?","У него не болит спина.","Сегодня у неё болит зуб.","У малыша болит живот.","У нас болят ноги.","У вас болят ноги?","После спорта у них всё болит.","Что у Вас болит?"],["У меня сильно болел зуб.","Тебе было больно от укола?","Колено у него не болело.","Вчера у неё болела голова.","У ребёнка болел живот.","Нам жали туфли.","У вас болела спина?","У них болели руки.","Где у Вас болело?"]],
"werden":[["Мне скоро тридцать.","Ты станешь учительницей?","В мае он станет отцом.","Скоро она станет ветеринаром.","Завтра будет хорошая погода.","Сегодня мы не закончим.","Вы часто болеете зимой?","Осенью они станут родителями.","Вы станете врачом?"],["Я стал ветеринаром.","Ты заболел?","Он не устал.","В прошлом году она стала мамой.","Погода стала холодной.","Мы стали хорошими друзьями.","Вы промокли?","Со временем они стали спокойнее.","Вы стали учителем?"]],
"wissen":[["Я знаю ответ.","Ты знаешь, где вокзал?","Он не знает, который час.","Конечно, она это знает.","Ребёнок уже много знает.","Мы знаем дорогу.","Вы знаете, когда начинается курс?","К сожалению, они этого ещё не знают.","Вы знаете, который час?"],["Я этого не знал.","Ты это знал?","Он знал ответ.","Конечно, она всё знала.","Ребёнок знал дорогу.","Мы давно это знали.","Вы это знали?","Раньше они ничего не знали.","Вы это знали?"]],
