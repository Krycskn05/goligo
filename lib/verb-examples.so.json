"abfahren":[["Saacadda 8-da ayaan ambabaxayaa.","Berri goorma ayaad ambabaxaysaa?","Isagu maanta ma ambabaxayo.","Isniinta goor hore ayay ambabaxaysaa.","Taksigu hadda wuu ambabaxayaa.","Sabtida ayaannu ambabaxaynaa.","Caawa ma ambabaxaysaan?","Saacadda 9-ka ayay ambabaxayaan.","Madashee ayaad ka ambabaxaysaa?"],["Tareen ayaan ku ambabaxay.","Waqtigii ma ku ambabaxday?","Maanta goorma ayuu ambabaxay?","Shalay saacadda 7-da ayay ambabaxday.","Markabku saacadda 10-ka ayuu ambabaxay.","Annagu weli ma ambabixin.","Axaddii ma ambabaxdeen?","Saaka ayay ambabaxeen.","Goorma ayaad Köln ka ambabaxday?"]],
"abgeben":[["Maanta ayaan dhiibayaa layliga guriga.","Furaha ma dhiibaysaa?","Berri ayuu celinayaa buugga.","Goorma ayay dhiibaysaa warqadda?","Ilmuhu wuxuu dhiibayaa kurraasadda.","Weli ma dhiibayno imtixaanka.","Foomka maanta ma dhiibaysaan?","Jimcaha ayay celinayaan buugaagta.","Shandadda xaggee ayaad ku dhiibaysaa?"],["Baakadda horey ayaan u dhiibay.","Imtixaanka ma dhiibtay?","Isagu kurraasadda ma dhiibin.","Shalay waxay dhiibtay imtixaanka.","Ilmuhu wuxuu dhiibay sawirka.","Isniintii ayaannu celinnay baabuurka.","Jaakadaha xaggee ayaad dhigteen?","Eyga ma u dhiibeen ayeeyo?","Kaarkaaga aqoonsiga ma dhiibtay?"]],
"anbieten":[["Koob kafee ah ayaan kuu fidinayaa.","Ayeeyo ma u fidinaysaa shaah?","Wuxuu noo fidinayaa keeg.","Maanta martida ayay u fidinaysaa casiir.","Maqaaxidu ma bixiso quraac.","Maxaannu u fidinaynaa carruurta?","Waxaad Max u fidinaysaan koob biyo ah.","Xagaaga waxay bixiyaan jalaato.","Ma bixisaan koorsooyin Jarmal ah sidoo kale?"],["Anna ayaan u fidiyay pizza.","Awoowe ma u fidisay kursi?","Wuxuu ii fidiyay meel aan fadhiisto.","Shalay waxay noo fidisay miro.","Hoteelku wuxuu noo fidiyay qol.","Annagu Tom maraq uma fidin.","Lena wax ma u fidiseen?","Isla markiiba waxay noo fidiyeen caawimaad.","Maxaad u fidisay martidaada?"]],
"anfangen":[["Maanta ayaan bilaabayaa barashada Jarmalka.","Goorma ayaad bilaabaysaa shaqada?","Isagu had iyo jeer waqtiga ayuu ku bilaabaa.","Isniinta ayay bilaabaysaa dugsiga.","Bandhigga muusiggu wuxuu bilaabmayaa saacadda 8-da.","Annagu weli ma bilaabayno.","Hadda ma bilaabaysaan cuntada?","Bisha Juun waxay bilaabayaan koorso.","Isniinta ma nala bilaabaysaa shaqada?"],["Shalay ayaan bilaabay buugga.","Ma bilowday weli?","Wuxuu bilaabay kubadda cagta.","Shalay goor hore ayay bilowday.","Ciyaarta waqtigeedii ayaa la bilaabay.","Bisha Maajo ayaannu bilownay.","Maxaad u bilaabi weydeen?","Toddobaad ka hor ayay bilaabeen.","Goorma ayaad halkan ka bilowday?"]],
"ankommen":[["Saacadda 10-ka ayaan gaarayaa Berlin.","Goorma ayaad guriga gaaraysaa?","Isagu had iyo jeer wuu soo daahaa.","Berri miyay tareen ku imanaysaa?","Baakaddu Jimcaha ayay imanaysaa.","Waqtiga ayaannu saldhigga ku gaaraynaa.","Idinku ma gaaraysaan saacadda 8-da ka hor.","Fiidka ayay hoteelka gaarayaan.","Saacaddee ayaad gaaraysaa?"],["Si nabad ah ayaan u gaaray Vienna.","Shalay goorma ayaad timid?","Isagu weli ma iman.","Axaddii ayay timid.","Taksigu horeba wuu yimid.","Saacadda 11-ka ayaannu nimid.","Si nabad ah ma u timaaddeen?","Xalay ayay yimaadeen.","Ma bas ayaad ku timid?"]],
"anrufen":[["Caawa ayaan ku wacayaa.","Berri ma wacaysaa ayeeyo?","Isagu hooyadiis ayuu inta badan wacaa.","Maalin kasta waxay wacdaa aabbe.","Ilmuhu wuxuu wacayaa hooyo.","Dhakhtarka maxaynu u wici weynaa?","Axadda ayaad na wacaysaan.","Berri waxay wacayaan dugsiga.","Isniinta ma i wacaysaa?"],["Shalay ayaan wacay Lena.","Yaad wacday?","Isagu ima wicin.","Saaka waxay wacday awoowe.","Isbitaalku wuu na soo wacay.","Waxaannu wacnay hoteelka.","Tom ma horey u wacdeen?","Shalay saddex jeer ayay soo waceen.","Maanta ma i soo wacday?"]],
"anziehen":[["Waxaan xiranayaa funaanad diiran.","Berri maxaad xiranaysaa?","Isagu jaakad ma xiranayo.","Berri waxay xiranaysaa goon.","Ilmuhu wuxuu xiranayaa kabaha.","Jiilaalka waxaannu xirannaa gacmo-gashi.","Ma xiranaysaan koodhadhkiinna?","Maanta waxay xiranayaan jiinis.","Maanta ma xiranaysaa suud?"],["Si dhakhso ah ayaan dharka u xirtay.","Ma xiratay koofiyad?","Wuxuu xirtay shaatiga cusub.","Shalay iyadu sharabaad ma xiran.","Ilmuhu keligiis ayuu dharka xirtay.","Waxaannu xiranay dhar diiran.","Maxaad u xirateen xafladda?","Maanta waxay xirteen kabo dhaadheer.","Kabo noocee ah ayaad xiratay?"]],
"aufstehen":[["Maalin kasta saacadda 6-da ayaan kacaa.","Axadda goorma ayaad kacdaa?","Isagu ma jecla inuu kaco.","Maanta saacadda 5-ta ayay kacaysaa.","Ilmuhu habeenkii badanaa wuu kacaa.","Dhammaadka toddobaadka goor dambe ayaannu kacnaa.","Ugu dambayn hadda ma kacaysaan?","Xagaaga aad bay goor hore u kacaan.","Sabtida sidoo kale ma kacdaa goor hore?"],["Nasiib darro goor dambe ayaan kacay.","Ma kacday weli?","Wuxuu kacay saacadda 6:30.","Maanta iyadu ma kicin.","Gabadhu isla markiiba way kacday.","Saacadda 4-ta ayaannu kacnay.","Maxaad sidaas goor hore ugu kacdeen?","Shalay duhurkii ayay kaceen.","Saacaddee ayaad kacday?"]],
"aussehen":[["Si fiican ma u muuqdaa?","Maanta aad ayaad u qurux badan tahay.","Wuxuu u eg yahay aabbihiis.","Maanta waxay u muuqataa mid aad u daallan.","Cuntadu waxay u eg tahay mid macaan.","Annagu uma muuqanno walaalo.","Maxaad sidaas ugu murugaysan tihiin?","Wada jir waxay u muuqdaan kuwo aad u faraxsan.","Maanta si aad u fiican ayaad u muuqataa."],["Sawirka waxaan ugu muuqday mid duq ah.","Sidee ayaad u muuqatay markaad yarayd?","Wuxuu u muuqday mid xoogaa buka.","Shalay iyadu si fiican uma muuqan.","Qolku wuxuu u muuqday mid cajiib ah.","Waxaannu u muuqannay sidii dalxiisayaal.","Hore ma si kale ayaad u muuqateen?","Fiidkii waxay u muuqdeen kuwo daallan.","Adigoo muraayad xiran waxaad u muuqatay mid ka da' yar."]],
"aussteigen":[["Agta dugsiga ayaan ka degaa.","Xaggee ayaad ka degaysaa?","Xarunta dawladda hoose ayuu ka degaa.","Berri waxay ka degaysaa Berlin.","Ilmuhu wuxuu ka degayaa xagga dambe.","Annagu halkan kama degayno.","Hadda ma degaysaan?","Saacadda 8-da ayay degayaan.","Ma ka degaysaa saldhigga weyn?"],["Aniga weli ma degin.","Goor hore miyaad ka degtay?","Wuxuu ka degay fagaaraha suuqa.","Shalay waxay ka degtay Köln.","Gabadhu waxay ka degtay xagga hore.","Waxaannu ka degnay garoonka diyaaradaha.","Xaggee ayaad ka degteen?","Axaddii halkan ayay ka degeen.","Ma ka degtay taksiga?"]],
"ausziehen":[["Aniga weli ma guurayo.","Goorma ayaad guuraysaa?","Wuxuu ka guurayaa guriga waalidkiis.","Toddobaadka soo socda ayay guuraysaa.","Lammaanuhu xagaaga ayay guurayaan.","Sabtida ayaannu guuraynaa.","Dhowaan ma guuraysaan?","Maxay u guurayaan?","Bisha Maajo ma guuraysaa?"],["Sannadkii hore ayaan guuray.","Ma guurtay weli?","Wuxuu ka guuray guriga ayeeyo.","Shalay ayay guurtay.","Gabadhu waxay guurtay iyadoo 18 jir ah.","Annagu ma guurin.","Jimcihii ma guurteen?","Goorma ayay guureen?","Toddobaadkii hore ma guurtay?"]],
"beginnen":[["Berri waxaan bilaabayaa shaqo cusub.","Goorma ayaad bilaabaysaa koorsada?","Maalinta wuxuu ku bilaabaa kafee.","Hadda waxay bilaabaysaa layliga guriga.","Bandhigga muusiggu wuxuu bilaabmayaa saacadda 20-ka.","Maanta ma bilaabayno.","Horeba ma bilaabaysaan?","Saacadda 9-ka ayay bilaabaan casharka.","Isniinta ma bilaabaysaa?"],["Weli ma bilaabin.","Cuntada ma bilowday horeba?","Wuxuu bilaabay saacadda 7-da.","Maanta waxay bilowday karinta.","Ciyaarta horeba waa la bilaabay.","Bisha Jannaayo ayaannu bilownay.","Goorma ayaad bilowdeen?","Waqtigii ma ku bilaabeen?","Goorma ayaad bilowday barashada Jarmalka?"]],
"bekommen":[["Maanta waxaan helayaa baakad.","Maalinta dhalashadaada maxaad helaysaa?","Isagu jawaab ma helo.","Berri waxay helaysaa baaskiil.","Canuggu wuxuu helayaa caano.","Inta badan marti ayaa noo timaadda.","Layli badan oo guriga ah ma heshaan?","Maanta ma helayaan boosto?","Maxaad rabtaa?"],["Waxaan helay iimayl.","Warqaddaydii ma heshay?","Shalay wuxuu helay hadiyad.","Iyadu ma heshay dhibco fiican?","Ilmuhu wuxuu helay jalaato.","Annagu tikidh ma helin.","Maxaad ku hesheen Kirismaska?","Bisha Maajo ilmo ayaa u dhashay.","Biilka ma heshay?"]],
"bleiben":[["Maanta guriga ayaan joogayaa.","Muddo intee le'eg ayaad joogaysaa?","Wuxuu Hamburg joogayaa laba toddobaad.","Axadda sariirta ayay ku sii jiiftaa.","Daaqaddu way furnaan doontaa.","Annagu muddo dheer ma joogayno.","Cuntada ma u joogaysaan?","Maanta waxay joogayaan ayeeyo agteeda.","Wax yar ma sii joogaysaa?"],["Maanta xafiiska ayaan joogay.","Muddo dheer ma joogtay xafladda?","Muxuu u joogi waayay?","Shalay waxay joogtay guriga Anna.","Maqaaxidu way sii xirnayd.","Saddex maalmood ayaannu joognay Rooma.","Ma joogteen ilaa dhammaadka?","Fiidkii waxay joogeen gurigayaga.","Ma joogtay hoteelka?"]],
"bringen":[["Kafee ayaan kuu keenayaa.","Carruurta ma geynaysaa dugsiga?","Wuxuu ayeeyo u keenayaa ubax.","Maanta waxay keenaysaa keeg.","Taksigu wuxuu na geynayaa saldhigga.","Maanta cabbitaan ma keenayno.","Maxaad u keenaysaan xafladda?","Isniinta waxay keenayaan sofaha.","Fadlan biyo ma ii keeni kartaa?"],["Waxaan keenay rooti yaryar.","Buugga ma keentay?","Wuxuu i geeyay guriga.","Iyadu ma geysay baakadda boostada?","Ilmuhu wuxuu keenay sawir.","Annagu hadiyado ma keenin.","Carruurta ma seexiseen?","Maanta waxay keeneen pizza.","Baabuurka xaggee ayaad geysay?"]],
"denken":[["Inta badan waan ka fikiraa ayeeyo.","Yaad ka fikiraysaa?","Wuxuu ka fikiraa kubadda cagta oo keliya.","Maalin kasta waxay ka fikirtaa qoyskeeda.","Ilmuhu wuxuu ka fikirayaa Kirismaska.","Waxaannu ka fikiraynaa fasaxa.","Ma xasuusanaysaan layliga guriga?","Maanta kama fikirayaan shaqada.","Inta badan ma ka fikirtaa carruurtaada?"],["Waan kaa fikiray.","Ma xasuusatay caanaha?","Isagu ma xasuusan ballanta.","Shalay waxay ka fikirtay aabbe.","Gabadhu wax walba way xasuusatay.","Aad ayaannu idinka fikirnay.","Ma xasuusateen tikidhada?","Maxay ka fikireen?","Ma xasuusatay baasaboorkaaga?"]],
"einladen":[["Cunto ayaan kugu martiqaadayaa.","Yaad u martiqaadaysaa xafladda?","Wuxuu martiqaadayaa saaxiibbadiis.","Maanta waxay Anna ku martiqaadaysaa kafee.","Ilmuhu wuxuu martiqaadayaa shan saaxiib.","Annagu Max ma martiqaadayno.","Lena sidoo kale ma martiqaadaysaan?","Sabtida waxay martiqaadayaan deriskooda.","Ma martiqaadaysaa asxaabtaada shaqada?"],["Waxaan martiqaaday fasalka oo dhan.","Ma martiqaadday Tom?","Wuxuu igu martiqaaday shineemo.","Shalay way na martiqaadday.","Gabadhu waxay martiqaadday awoowe.","Annagu dad badan ma martiqaadin.","Yaad martiqaaddeen?","Adigana ma ku martiqaadeen?","Ma martiqaadday qoyskaaga?"]],
"empfehlen":[["Waxaan kugula talinayaa maraqa.","Maxaad igula talinaysaa?","Isagu kuma taliyo makhaayadda.","Maanta waxay ku talinaysaa kalluunka.","Hoteelku wuxuu ku talinayaa taksi.","Waxaannu ku talinaynaa maqaaxida suuqa.","Filimka ma ku talinaysaan?","Tareenka ma ku talinayaan?","Maanta maxaad ku talinaysaa?"],["Waxaan Anna kula taliyay dhakhtar.","Buugga ma igula talisay?","Wuxuu nagula taliyay pizza-ha.","Shalay waxay igula talisay shaah.","Xafiiska socdaalku wuxuu ku taliyay Rooma.","Annagu kuma talin shineemada.","Max maxaad kula taliseen?","Koorsada ma kugula taliyeen?","Hoteelkee ayaad ku talisay?"]],
"essen":[["Waxaan jeclahay inaan cuno baasto.","Quraacda maxaad cuntaa?","Isagu hilib ma cuno.","Duhurkii waxay wax ku cuntaa makhaayadda shaqada.","Canuggu wuxuu jecel yahay muus.","Axadda waxaannu wax ku cunnaa ayeeyo gurigeeda.","Maanta ma wax ku cunaysaan makhaayad?","Fiidkii inta badan waxay cunaan pizza.","Kalluun ma jeceshahay?"],["Shukulaato aad u badan ayaan cunay.","Wax ma cuntay weli?","Wuxuu cunay tufaax.","Shalay waxay cuntay maraq.","Ilmuhu khudrad ma cunin.","Waxaannu wax ku cunnay beerta nasashada.","Shalay maxaad cunteen?","Keegga oo dhan ma cuneen?","Si fiican ma wax u cuntay?"]],
"fahren":[["Maanta waxaan raacayaa bas.","Berri ma tagaysaa Berlin?","Isniinta wuxuu shaqada baabuur ugu tagaa.","Inta badan baaskiil ma wadataa?","Taksigu wuxuu u socdaa saldhigga.","Dhammaadka toddobaadka waxaannu tagaynaa badda.","Goorma ayaad guriga u tagaysaan?","Iyagu maanta magaalada ma tagayaan.","Ma raacaysaa tareenka dhulka hoose?"],["Aniga taksi ma raacin.","Ma tareen ayaad raacday?","Toddobaadkii hore wuxuu u tagay ayeeyo.","Iyadu keligeed ma u tagtay dugsiga?","Ilmuhu baaskiil ayuu ku tagay.","Axaddii waxaannu tagnay harada.","Fasaxa xaggee ayaad u safarteen?","Fiidkii waxay u tageen guriga.","Shalay ma u safartay Vienna?"]],
"finden":[["Furahayga ma helayo.","Buuggu sidee kula yahay?","Isaga gurigu wuxuu la yahay mid qaali ah.","Iyadu filimka ma ka helaysaa?","Ilmuhu wuxuu helayaa hal yuuro.","Maanta ma helayno meel aannu baabuurka dhigno.","Jarmalka ma idinla adag yahay?","Beerta nasashada waxay ka helayaan bisad.","Ma helaysaa jidka saldhigga?"],["Waxaan helay guri.","Ma heshay muraayaddaada?","Ugu dambayn wuxuu helay shaqo.","Waxay baska ku heshay mobayl.","Gabadhu waxay heshay bisadda.","Annagu ma helin hoteelka.","Xaggee ayaad ka hesheen eyga?","Isniintii waxay heleen lacagta.","Ma heshay baasaboorkaaga?"]],
"fliegen":[["Xagaaga waxaan u duulayaa Isbeyn.","Fasaxa xaggee ayaad u duulaysaa?","Berri wuxuu u duulayaa Baariis.","Iyadu maanta ma u duulaysaa London?","Diyaaraddu waxay duulaysaa saacadda 8-da.","Annagu duulista kama helno.","Jimcaha ma u duulaysaan Vienna?","Jiilaalka waxay u duulaan Talyaaniga.","Inta badan ma u duushaa Berlin?"],["Shalay waxaan u duulay Hamburg.","Weligaa diyaarad ma raacday?","Bisha Maajo wuxuu u duulay Kanada.","Shalay waxay u duushay Madriid.","Diyaaraddu waxay u duushay Qaahira.","Sannadkan annagu ma duulin.","Goorma ayaad guriga u duusheen?","Berlin ma u wada duuleen?","Muddo intee le'eg ayaad duushay?"]],
"geben":[["Telefoonkayga ku siin maayo.","Fadlan cusbada ma i siin kartaa?","Wuxuu ilmaha siinayaa tufaax.","Maanta waxay samaynaysaa xaflad.","Halkan suuq weyn ma ku yaal?","Waxaannu ayeeyo siinaynaa ubaxa.","Max maxaad u siinaysaan dhalashadiisa?","Berri waxay qabanayaan bandhig muusig.","Lacag aad u badan ayaad i siinaysaa."],["Waxaan hooyo siiyay hadiyad.","Tom ma siisay lambarkaaga?","Shalay isagu lacag ima siin.","Maxay ku siisay?","Shalay pizza ayaa jirtay.","Waxaannu eyga siinnay biyo.","Macallinka ma siiseen kurraasadda?","Maqaaxida waxay na siiyeen keeg.","Furaha yaad siisay?"]],
"gefallen":[["Magaalada aad baan u jeclahay.","Guriga cusub ma jeceshahay?","Isagu filimka kama helo.","Iyadu kabaha cas way jeceshahay.","Ilmuhu ciyaarta wuu jecel yahay.","Beerta nasashada aad baannu u jecelnahay.","Berlin sidee idinla tahay?","Hadda dugsiga way jecel yihiin.","Muusigga ma jeceshahay?"],["Fasaxa aad ayaan uga helay.","Bandhigga muusigga ma ka heshay?","Xafladda aad buu uga helay.","Iyadu hadiyadda ma ka heshay?","Ilmuhu buugga wuu ka helay.","Annagu hoteelka kama helin.","Socdaalka sidee idinla ahaa?","Shalay beerta xayawaanka aad bay uga heleen.","Cuntada ma ka heshay?"]],
"gehen":[["Maanta waxaan tagayaa shineemada.","Berri ma tagaysaa dugsiga?","Saacadda 10-ka ayuu sariirta galaa.","Iyadu maanta shaqo ma tagayso.","Sidee tahay?","Sabtida waxaannu u baxaynaa wax iibsi.","Inta badan ma tagtaan beerta nasashada?","Fiidka waxay tagaan makhaayad.","Saldhigga ma u lugaynaysaa?"],["Shalay waxaan u tagay dhakhtarka.","Goorma ayaad guriga u tagtay?","Isagu xafladda ma tagin.","Axaddii waxay u baxday dabbaal.","Ilmuhu wuxuu galay beerta.","Shalay waxaannu tagnay matxafka.","Ma wada socod u baxdeen?","Kadib waxay tageen maqaaxi.","Horeba ma u baxday wax iibsi?"]],
"gelten":[["Tikidhku aniga sidoo kale wuu ii shaqeeyaa.","Kaarku adiga sidoo kale ma kuu shaqeeyaa?","Xeerku isaga ma khuseeyo.","Iyada waxaa khuseeya qiimaha carruurta.","Xeerku ilmaha sidoo kale wuu khuseeyaa.","Tikidhadu annaga oo dhan way noo shaqeeyaan.","Xeerarkee ayaa idin khuseeya?","Iyaga waxaa khuseeya qiimayaal kale.","Maanta qiimuhu adiga sidoo kale wuu ku khuseeyaa."],["Xeerku aniga sidoo kale wuu i khuseeyay.","Tikidhku ma kuu shaqeeyay?","Dalabku isaga ma khusayn.","Qiimuhu iyada sidoo kale ma khuseeyay?","Kaarku ilmaha wuu u shaqeeyay.","Bisha Maajo tikidhku wuu noo shaqeeyay.","Qiimahee ayaa idin khuseeyay?","Iyaga waxaa khuseeyay xeerar kale.","Kaarku ma adiga oo keliya ayuu kuu shaqeeyay?"]],
"heißen":[["Magacaygu waa Anna.","Magacaagu waa maxay?","Magaciisu ma aha Max.","Hadda magaceedu waa Becker.","Canugga magaciisu waa Tom.","Magacyadayadu waa Max iyo Lena.","Magaca qoyskiinnu waa maxay?","Labadooduba ma Anna ayaa la yiraahdaa?","Magacaagu waa maxay?"],["Hore magacaygu wuxuu ahaa Schmidt.","Magacaagu miyuusan ahayn Tom?","Magaciisu muxuu ahaa mar kale?","Ilaa Maajo magaceedu wuxuu ahaa Wagner.","Magaca buuggu muxuu ahaa?","Magacayagu had iyo jeer sidaas ma ahayn.","Hore magaca qoyskiinnu ma Müller buu ahaa?","Waagaas magacoodu wuxuu ahaa Meyer.","Hore magacaagu muxuu ahaa?"]],
"herunterladen":[["Waxaan soo dejinayaa abka.","Sawirka ma soo dejinaysaa?","Maalin kasta wuxuu soo dejiyaa muusig.","Maanta waxay soo dejinaysaa filim.","Telefoonku wuxuu soo dejinayaa sawirrada.","Annagu ciyaaro ma soo dejinno.","Maxaad halkaas ka soo dejinaysaan?","Fiidka waxay soo dejiyaan sawirrada.","Tikidhka xaggee ayaad ka soo dejisaa?"],["Waxaan soo dejiyay buugga.","Fiidyowga ma soo dejisay?","Wuxuu soo dejiyay qaamuus.","Iyadu jadwalka tareennada ma soo dejisay?","Ilmuhu wuxuu soo dejiyay ciyaar.","Annagu wax ab ah ma soo dejin.","Heesaha ma soo dejiseen?","Kadib waxay soo dejiyeen abka.","Sawirrada ma soo dejisay?"]],
"helfen":[["Hooyo ayaan jikada ka caawinayaa.","Layliga guriga ma igu caawinaysaa?","Sabtida wuxuu awoowe ka caawiyaa beerta.","Maanta waxay caawinaysaa deriskeeda.","Ilmuhu wuxuu ka caawiyaa karinta.","Farxad ayaannu kugu caawinaynaa.","Maxaad Tom u caawin weydaan?","Dhammaadka toddobaadka waxay ka caawiyaan maqaaxida.","Runtii aad ayaad ii caawinaysaa."],["Aabbe ayaan ka caawiyay nadiifinta.","Shalay yaad caawisay?","Isagu ima caawin.","Shalay waxay caawisay macallinka.","Daawadu si dhakhso ah ayay wax u tartay.","Waxaannu caawinnay deriskayaga.","Anna ma ka caawiseen shandadda?","Nasiib wanaag way na caawiyeen.","Ma caawisay hooyadaa?"]],
"kennen":[["Macallinka si fiican ayaan u aqaan.","Walaashay ma taqaan?","Isagu magaalada ma yaqaan.","Iyadu jidka saldhigga ma taqaan?","Ilmuhu heeso badan ayuu yaqaan.","Waxaannu naqaan makhaayad fiican.","Tom xaggee ka taqaaniin?","Hadda waxay yaqaaniin macallimadda cusub.","Waddadan ma taqaan?"],["Aniga ninka ma aqoon.","Heesta horey ma u tiqiin?","Wuxuu yiqiin erayada oo dhan.","Iyadu filimka ma tiqiin?","Gabadhu jawaabta way tiqiin.","Hoteelka si fiican ayaannu u niqiin.","Jidka xaggee ka tiqiinneen?","Halkan dad badan ayay yiqiinneen.","Aabbahay ma tiqiin?"]],
"kommen":[["Waxaan ka imid Turkiga.","Goorma ayaad guriga imanaysaa?","Isagu maanta shaqada ma imanayo.","Berri waxay ku imanaysaa bas.","Canuggu wuxuu dhalanayaa bisha Maajo.","Saacadda 8-da ayaannu imanaynaa.","Sabtida xafladda ma imanaysaan?","Axadda waxay u imanayaan cunto.","Xaggee ayaad ka timid?"],["Aad ayaan u soo daahay.","Sidee ayaad shaqada ku timid?","Isagu dugsiga ma iman.","Shalay waxay ku timid tareen.","Baakaddu maanta ayay timid.","Baaskiil ayaannu ku nimid.","Guriga si nabad ah ma ku gaarteen?","Saacadda 9-ka ayay yimaadeen.","Goorma ayaad timid Berlin?"]],
"laufen":[["Subax kasta beerta nasashada ayaan ka ordaa.","Ma u lugaysaa dugsiga?","Isagu si dhakhso ah ayuu u ordaa.","Axadda waxay ordaysaa toban kiiloomitir.","Canuggu weli ma socon karo.","Waxaannu guriga u wada lugaynaa.","Xaggee ayaad si dhakhso ah ugu ordaysaan?","Maanta waxay u lugaynayaan suuqa weyn.","Ma jeceshahay inaad kaynta ku orodo?"],["Saldhigga ayaan u lugeeyay.","Maanta ma orodday horeba?","Shalay isagu ma ordin.","Xaggee ayay u orodday?","Ilmuhu wuxuu u orday hooyadiis.","Magaalada ayaannu dhex lugaynay.","Ilaa harada ma lugayseen?","Sabtidii waxay ku ordeen beerta nasashada.","Maanta shaqada ma u lugaysay?"]],
"leidtun":[["Waan ka xumahay.","Maxaad ka xun tahay?","Runtii wuu ka xun yahay arrintaas.","Hadda way ka xun tahay.","Ilmuhu wuu ka xun yahay arrintaas.","Aad baannu uga xunnahay arrintaas.","Arrintaas ma ka xun tihiin?","Iyaguna way ka xun yihiin arrintaas.","Ma ka xun tahay?"],["Arrintaas aad baan uga xumaaday.","Ma ka xumaatay?","Shalay wuu ka xumaaday.","Iyadu arrintaas ma ka xumaatay?","Gabadhu arrintaas way ka xumaatay.","Runtii aad baannu uga xumaannay.","Maxaad ka xumaateen?","Iyaguna arrintaas way ka xumaadeen.","Arrintaas ma ka xumaatay?"]],
"leihen":[["Baaskiilkayga ayaan ku amaahinayaa.","Qalinkaaga ma i amaahinaysaa?","Isagu Anna ma amaahiyo telefoonkiisa.","Maanta waxay Tom amaahinaysaa buug.","Ilmuhu wuxuu Lena amaahinayaa kubaddiisa.","Waxaannu aabbe amaahinnaa baabuurkayaga.","Kuraastiinna ma na amaahinaysaan?","Berri waxay hooyo amaahinayaan shandad.","Fadlan dalladdaada ma i amaahin kartaa?"],["Max waxaan amaahiyay qaamuuskayga.","Kamaradaada yaad amaahisay?","Wuxuu i amaahiyay toban yuuro.","Jaakaddeeda ma ku amaahisay?","Gabadhu waxay i amaahisay ciyaar.","Annagu Lena lacag ma amaahin.","Aabbe ma amaahiseen boorsada dhabarka?","Shalay waxay i amaahiyeen buugaag.","Isaga ma amaahisay lacagta?"]],
"lesen":[["Habeen kasta sariirta ayaan wax ku akhriyaa.","Hadda maxaad akhrinaysaa?","Isagu akhriska ma jecla.","Subaxdii waxay akhrisaa iimaylladeeda.","Ilmuhu horeba si fiican ayuu wax u akhriyaa.","Koorsada waxaannu ku akhrinaynaa qoraal.","Fariinta hooyo ma akhrinaysaan?","Tareenka waxay ku akhriyaan wargeyska.","Ma jeceshahay inaad buugaag akhrido?"],["Warqadda horeba waan akhriyay.","Fariintayda ma akhrisay?","Isagu hawsha ma akhrin.","Shalay waxay akhrisay saddex bog.","Ilmuhu wuxuu akhriyay sheeko.","Waxaannu akhrinnay buugga oo dhan.","Fasaxa maxaad akhriseen?","Fiidkii waxay wax akhriyeen muddo dheer.","Iimaylka ma akhrisay?"]],
"liegen":[["Anigoo buka ayaan sariirta ku jiifaa.","Maxaad dhulka ugu jiifaysaa?","Isagu ma jecla inuu qorraxda ku jiifo.","Hadda waxay ku jiifaysaa sofaha.","Telefoonku miiska ayuu saaran yahay.","Axadda waxaannu ku jiifnaa beerta.","Ma jeceshihiin inaad xeebta ku jiiftaan?","Xagaaga inta badan waxay ku jiifaan harada agteeda.","Si raaxo leh ma u jiiftaa?"],["Baafka ayaan ku jiifay.","Isbitaal ma ku jiiftay?","Isagu sariirta muddo dheer kuma jiifin.","Iyadu muddo dheer ma ku jiiftay qorraxda?","Buuggu xaggee buu yiil?","Shalay cawska ayaannu ku jiifnay.","Balakoonka ma ku jiifteen?","Fasaxa waxay ku jiifeen badda agteeda.","Muddo intee le'eg ayaad halkaas ku jiiftay?"]],
"mitbringen":[["Keeg ayaan keenayaa.","Maxaad u keenaysaa xafladda?","Isagu maanta casiir ma keenayo.","Berri waxay keenaysaa gitaarkeeda.","Ilmuhu wuxuu soo kaxaynayaa saaxiib.","Waxaannu keenaynaa rooti iyo farmaajo.","Carruurtiinna ma soo kaxaynaysaan?","Axadda waxay keenayaan ubax.","Eygaaga ma soo kaxaynaysaa?"],["Wax ayaan kuu keenay.","Lacagta ma keentay?","Wuxuu keenay rooti yaryar.","Shalay waxay keentay miro.","Ilmuhu wuxuu keenay sawir.","Annagu cabbitaan ma keenin.","Maxaad ka keenteen Talyaaniga?","Jimcihii waxay keeneen saladh.","Kaarkaaga aqoonsiga ma keentay?"]],
"mitkommen":[["Si farxad leh ayaan idin raacayaa.","Shineemada ma na raacaysaa?","Nasiib darro isagu nama raacayo.","Berri iyaduna way raacaysaa.","Ilmuhu wuu na raacayaa dhakhtarka.","Waannu ku raacaynaa ilaa saldhigga.","Bandhigga muusigga ma na raacaysaan?","Sabtida waxay na raacayaan suuqa.","Caawa ma na raacaysaa?"],["Si farxad leh ayaan u raacay.","Matxafka ma raacday?","Wax iibsi ayuu na raacay.","Shalay waxay na raacday shineemada.","Canugguna wuu na raacay.","Waxaannu raacnay ciyaarta kubadda cagta.","Beerta xayawaanka ma raacdeen?","Isniintii iyagu nama raacin.","Magaalada ma raacday?"]],
"mitnehmen":[["Dallad ayaan sii qaadanayaa.","Jaakaddaada ma qaadanaysaa?","Isagu telefoonkiisa ma qaato.","Maanta eygeeda ayay kaxaysanaysaa.","Ilmuhu wuxuu qaadanayaa caruusaddiisa.","Waxaannu qaadannaa biyo iyo rooti.","Carruurta ma kaxaysanaysaan?","Fasaxa waxay qaataan buugaag badan.","Fadlan baasaboorkaaga qaado."],["Dalladdayda ayaan qaatay.","Furaha ma qaadatay?","Isagu jaakad ma qaadan.","Shalay eygeeda ayay kaxaysatay.","Ilmuhu kubaddiisa ayuu qaatay.","Biyo ku filan ayaannu qaadannay.","Sawirrada ma qaadateen?","Hadiyadda ma qaateen?","Kaarkaaga aqoonsiga ma qaadatay?"]],
"nehmen":[["Buug ayaan ka qaadanayaa armaajada.","Kafeegaaga caano ma ku darsataa?","Maanta wuxuu raacayaa bas.","Iyadu subaxdii sonkor ma qaadato.","Ilmuhu wuxuu qaadanayaa tufaax.","Waxaannu raacnaa tareenka dhulka hoose.","Cunto ahaan maxaad dalbanaysaan?","Maanta waxay raacayaan taksi.","Fadlan fadhiiso."],["Buugga ayaan qaatay.","Qalinkayga ma qaadatay?","Isagu tareenka ma raacin.","Maanta waxay qaadatay baaskiilka.","Ilmuhu wuxuu qaatay buskudka.","Waxaannu raacnay taksi.","Baskee ayaad raacdeen?","Shalay waxay raaceen jaranjarada.","Kiniinadaada ma qaadatay?"]],
"rufen":[["Walaalkay ayaan u yeerayaa.","Maxaad sidaas ugu qaylinaysaa?","Isagu eygiisa uma yeero.","Beerta nasashada waxay ugu yeertaa saaxiibaddeed.","Canuggu hooyo ayuu u yeerayaa.","Waxaannu u yeeraynaa adeegaha.","Carruurta ma ugu yeeraysaan cuntada?","Fiidka waxay u yeeraan bisaddooda.","Fadlan u yeer dhakhtarka!"],["Saddex jeer ayaan qayliyay.","Ma ii yeertay?","Isagu cod dheer kuma qaylin.","Shalay waxay u yeertay booliiska.","Ilmuhu wuxuu u yeeray aabbe.","Waxaannu u yeernay taksi.","Dhakhtarka ma u yeerteen?","Cod dheer ayay gargaar ugu qayliyeen.","Ambalaaska ma u yeertay?"]],
"scheinen":[["Meesha aan joogo maanta qorraxdu way ifaysaa.","Meesha aad joogtana qorraxdu ma ifaysaa?","Meesha uu joogo qorraxdu ma ifayso.","Meesha ay joogto hadda qorraxdu way ifaysaa.","Guriga agtiisa qorraxdu inta badan way iftaa.","Meesha aannu joogno subaxdii qorraxdu way iftaa.","Meesha aad joogtaan qorraxdu ma ifaysaa?","Meesha ay joogaan qorraxdu marar dhif ah ayay iftaa.","Meesha aad joogto maanta qorraxdu ma ifaysaa?"],["Meesha aan joogay maanta qorraxdu way iftay.","Meesha aad joogtay qorraxdu ma iftay?","Meesha uu joogay qorraxdu ma ifin.","Meesha ay joogtay qorraxdu muddo dheer way iftay.","Guriga agtiisa qorraxdu ma iftay?","Meesha aannu joognay qorraxdu way iftay.","Meesha aad joogteen qorraxdu ma iftay?","Meesha ay joogeen qorrax ma jirin.","Meesha aad joogtay qorraxdu ma iftay?"]],
"schlafen":[["Siddeed saacadood ayaan seexdaa.","Horeba ma seexatay?","Isagu si fiican uma seexdo.","Axadda muddo dheer ayay seexataa.","Canuggu wuxuu ku seexanayaa gaariga carruurta.","Fasaxa waxaannu ku seexannaa teendho.","Ayeeyo gurigeeda ma seexanaysaan?","Habeenkii si deggan ayay u seexdaan.","Si fiican u seexo!"],["Xalay si fiican ayaan u seexday.","Si fiican ma u seexatay?","Isagu wax yar oo keliya ayuu seexday.","Tareenka ayay ku seexatay.","Ilmuhu ma seexan.","Hoteelka ayaannu ku seexannay.","Xaggee ayaad seexateen?","Shalay muddo dheer ayay seexdeen.","Si fiican ma u seexatay?"]],
"schließen":[["Daaqadda ayaan xirayaa.","Fadlan albaabka ma xiraysaa?","Isagu albaabka ma xiro.","Saacadda 8-da ayay xirtaa dukaanka.","Dukaanku wuxuu xirmaa saacadda 20-ka.","Waxaannu xiraynaa indhaha.","Goorma ayaad xirtaan maqaaxida?","Fiidka waxay xiraan daaqadaha.","Fadlan albaabka xir."],["Daaqadaha oo dhan ayaan xiray.","Albaabka ma xirtay?","Isagu daaqadda ma xirin.","Si aamusnaan ah ayay albaabka u xirtay.","Ilmuhu wuxuu xiray indhihiisa.","Dukaanka goor hore ayaannu xirnay.","Garaashka ma xirteen?","Shalay waxay xireen xafiiska.","Daaqadda ma xirtay?"]],
"schneiden":[["Rootiga ayaan jarayaa.","Yaanyada ma jaraysaa?","Isagu hilibka ma jarayo.","Hadda waxay jaraysaa keegga.","Mindidu si fiican ayay wax u jartaa.","Waxaannu tufaax u jarnaa saladhka.","Basasha ma jaraysaan?","Beerta waxay ka jaraan ubax.","Fadlan timaha ii gaabi."],["Farta ayaan iska jaray.","Khudradda ma jartay?","Isagu rootiga ma jarin.","Shalay waxay jartay keegga.","Ilmuhu wuxuu jaray warqad.","Geedaha xayndaabka ayaannu jarnay.","Basasha ma jarteen?","Si dhakhso ah ayay u jareen miraha.","Soseejada ma jartay?"]],
"schreiben":[["Ayeeyaday ayaan warqad u qorayaa.","Fariin ma ii soo qoraysaa?","Isagu ma jecla inuu iimayl qoro.","Maalin kasta waxay wax ku qortaa kurraasaddeeda.","Ilmuhu wuxuu qorayaa magaciisa.","Berri waxaannu qoraynaa imtixaan.","Qalin qori ma ku qoraysaan?","Inta badan waxay qoraan kaararka boostada.","Fadlan qor cinwaankaaga."],["Waxaan kuu qoray iimayl.","Kaarka boostada ma qortay?","Isagu fariin ma qorin.","Shalay waxay qortay gabay.","Ilmuhu wuxuu qoray eray.","Imtixaanka si fiican ayaannu u qornay.","Maxaad qorteen?","Muddo dheer ayay warqado qoreen.","Warqadda ma qortay?"]],
"schwimmen":[["Subax kasta waan dabbaal galaa.","Ma jeceshahay dabbaasha badda?","Isagu dabbaasha kuma fiicna.","Xagaaga waxay dabbaal ku gashaa harada.","Ilmuhu horeba keligiis ayuu dabbaal galaa.","Barkadda dabbaasha ayaannu dabbaal ku galnaa.","Maanta ma dabbaal galaysaan?","Dhammaadka toddobaadka aad bay dabbaal u galaan.","Jiilaalkana ma dabbaal gashaa?"],["Laba kiiloomitir ayaan dabbaalay.","Weligaa badda ma ku dabbaal gashay?","Isagu meel fog uma dabbaalin.","Shalay waxay dabbaal ku gashay webiga.","Ilmuhu markii ugu horreysay ayuu dabbaal galay.","Harada ayaannu dabbaal ku galnay.","Muddo dheer ma dabbaal gasheen?","Fasaxa aad bay dabbaal u galeen.","Maanta ma dabbaal gashay?"]],
"sehen":[["Waxaan arkaa shimbir geedka saaran.","Markabka halkaas ma aragtaa?","Isagu muraayad la'aan si fiican wax uma arko.","Daaqadda ayay ka aragtaa beerta nasashada.","Canuggu wuxuu arkaa hooyadiis.","Waxaannu shineemada ka daawanaynaa filim.","Buuraha ma aragtaan?","Subaxdii waxay arkaan shimbiro badan.","Calaamadda halkaas ma aragtaa?"],["Filimka horeba waan daawaday.","Muraayaddayda ma aragtay?","Isagu baska ma arag.","Shalay waxay aragtay dawaco.","Ilmuhu wuxuu daawaday sirkaska.","Waxaannu aragnay badda.","Shilka ma aragteen?","Beerta xayawaanka waxay ku arkeen maroodiyaal.","Eygayga ma aragtay?"]],
"singen":[["Waxaan jeclahay inaan ku heeso qubayska.","Ma ku heestaa kooxda heesaha?","Isagu ma jecla inuu cod dheer ku heeso.","Fiidka waxay qaaddaa hees.","Ilmuhu wuxuu qaadayaa hees carruureed.","Waxaannu wada heesnaa karaoke.","Xafladda ma ka heesaysaan?","Baabuurka had iyo jeer cod dheer ayay ku heesaan.","Ma jeceshahay heesidda?"],["Hees ayaan kuu qaaday.","Weligaa karaoke ma heestay?","Isagu si fiican uma heesin.","Shalay waxay ku heestay kooxda heesaha.","Ilmuhu cod dheer ayuu ku heesay.","Waxaannu qaadnay Happy Birthday.","Ma wada heesteen?","Muddo dheer ayay dabka agtiisa ku heeseen.","Heesta ma qaadday?"]],
"sitzen":[["Beerta nasashada kursi ayaan ku fadhiyaa.","Si raaxo leh ma u fadhidaa?","Isagu ma jecla inuu muddo dheer fadhiyo.","Shineemada waxay ku fadhidaa safka hore.","Ilmuhu dhulka ayuu fadhiyaa.","Beerta ayaannu fadhinnaa.","Tareenka ma fuusheen horeba?","Fiidka waxay fadhiyaan telefishanka hortiisa.","Halkan ma fadhidaa?"],["Maqaaxida muddo dheer ayaan fadhiyay.","Daaqadda agteeda ma fadhiday?","Isagu xagga hore kuma fadhiisan.","Shalay waxay fadhiday beerta.","Ilmuhu dhabtayda ayuu ku fadhiyay.","Baska xagga dambe ayaannu ka fadhinnay.","Shineemada xaggee ayaad ka fadhideen?","Saacado badan ayay miiska fadhiyeen.","Si fiican ma u fadhiday?"]],
"sprechen":[["Waxaan ku hadlaa af Turki iyo af Jarmal.","Af Ingiriis ma ku hadashaa?","Isagu wax badan ma hadlo.","Telefoonka cod hoose ayay ku hadashaa.","Canuggu horeba hal eray ayuu yiraahdaa.","Waxaannu la hadlaynaa macallinka.","Af Isbaanish ma ku hadashaan?","Guriga waxay ku hadlaan af Carabi.","Fadlan si tartiib ah u hadal."],["Waxaan la hadlay maamuladdayda.","Anna ma la hadashay?","Isagu eray qudha ma oran.","Shalay waxay la hadashay Tom.","Ilmuhu cod hoose ayuu ku hadlay.","Waxaannu ka hadalnay fasaxa.","Dhakhtarka ma la hadasheen?","Telefoonka muddo dheer ayay ku hadleen.","Maamulaha ma la hadashay?"]],
"stehen":[["Joogsiga baska ayaan ku taaganahay.","Maxaad halkan u taagan tahay?","Isagu ma jecla ciriiriga gaadiidka.","Baska gudihiisa agtayda ayay taagan tahay.","Baabuurku guriga hortiisa ayuu yaal.","Waxaannu ku taagannahay meesha lacagta lagu bixiyo.","Horeba dibadda ma joogtaan?","Shineemada hortiisa waxay ku jiraan saf.","Fadlan halkan bidix ka istaag."],["Saacad ayaan ku jiray ciriiriga gaadiidka.","Muddo dheer ma ku istaagtay meesha lacag bixinta?","Isagu daaqadda agteeda ma istaagin.","Tareenka dhexdiisa waqtiga oo dhan way taaganayd.","Baaskiilku albaabka hortiisa ayuu yiil.","Baska dhexdiisa ayaannu istaagnay.","Xaggee ayaad istaagteen?","Muddo dheer ayay irridda agteeda istaageen.","Safka ma ku jirtay?"]],
"stoßen":[["Inta badan madaxa ayaan wax ku dhuftaa.","Maxaad ii riixaysaa?","Isagu ilmaha ma riixo.","Markay ciyaarayso waxay ku dhacdaa miiska.","Baabuurku wuxuu ku dhacayaa derbiga.","Kubadda madaxa ayaannu ku dhufannaa.","Inta badan madaxa ma wax ku dhufataan?","Ciriiriga dhexdiisa waxay riixaan dad kale.","Ha ku dhicin armaajada!"],["Madaxa ayaan wax ku dhuftay.","Jilibka ma wax ku dhufatay?","Isagu ma dhaawacmin.","Shalay waxay ku dhacday miiska.","Ilmuhu gacanta ayuu wax ku dhuftay.","Albaabka ayaannu ku dhacnay.","Madaxa ma wax ku dhufateen?","Mugdiga waxay ku dhaceen waxyaabo.","Ma dhaawacantay?"]],
"tragen":[["Waxaan qaadayaa sanduuq culus.","Boorsadayda ma qaadaysaa?","Isagu muraayad ma xirto.","Maanta waxay xiran tahay goon cas.","Ilmuhu wuxuu sitaa boorso dhabarka.","Miiska waxaannu u qaadaynaa qolka.","Shandadaha ma qaadaysaan?","Jiilaalka waxay xirtaan jaakado qaro weyn.","Fadlan sanduuqa kor u qaad."],["Waxaan qaaday alaabta la iibsaday.","Shandadda ma qaadday?","Isagu koofiyad ma xiran.","Shalay waxay xiratay goon.","Ilmuhu wuxuu qaaday ubaxa.","Waxaannu qaadnay sofaha.","Sanaadiiqda ma qaaddeen?","Muddo dheer ayay ilmaha qaadeen.","Boorsada ma qaadday?"]],
"treffen":[["Saaxiibaddayda ayaan maqaaxida kula kulmaa.","Maanta ma la kulmaysaa Tom?","Isagu inta badan lama kulmo asxaabtiisa shaqada.","Fiidka waxay la kulmaysaa waalidkeed.","Kooxdu saacadda 10-ka ayay kulmaysaa.","Waxaannu ku kulannaa shineemada hortiisa.","Goorma ayaad kulmaysaan?","Beerta nasashada waxay kula kulmaan deriskooda.","Berri ma la kulmaysaa Mudane Klein?"],["Anna ayaan baska kula kulmay.","Tom ma la kulantay?","Isagu lama kulmin saaxiibkiis.","Shalay waxay la kulantay macallimaddeedii.","Kooxdu beerta nasashada ayay ku kulantay.","Saldhigga ayaannu ku kulannay.","Xaggee ayaad ku kulanteen?","Si kadis ah ayay ula kulmeen Max.","Ma la kulantay Marwo Berg?"]],
"trinken":[["Waxaan cabbayaa koob biyo ah.","Ma cabtaa kafee mise shaah?","Isagu khamri ma cabbo.","Subaxdii waxay cabtaa casiir liin macaan.","Canuggu wuxuu cabbaa caano.","Waxaannu cabnaa shaah liin dhanaan leh.","Maxaad cabbaysaan?","Xagaaga waxay cabbaan biyo badan.","Kafee kale ma cabbaysaa?"],["Biyo aad u yar ayaan cabbay.","Kafee ma cabtay weli?","Isagu casiir ma cabbin.","Shalay waxay cabtay shaah badan.","Ilmuhu wuxuu cabbay caanaha.","Kafee ayaannu wada cabnay.","Maxaad cabteen?","Xafladda waxay ku cabbeen kooka.","Wax ku filan ma cabtay?"]],
"tun":[["Farxad ayaan kuugu samaynayaa taas.","Maanta maxaad samaynaysaa?","Isagu maanta wax badan ma samaynayo.","Maalin kasta waxay samaysaa wax wanaagsan.","Ilmuhu wax walba ayuu bisadda u sameeyaa.","Waxaannu samaynaa intii karaankayaga ah.","Dhammaadka toddobaadka maxaad samaynaysaan?","Deegaanka wax badan ayay u sameeyaan.","Fadlan taas ha samayn!"],["Maanta wax badan ayaan sameeyay.","Axaddii maxaad samaysay?","Isagu taas ma samayn.","Shalay wax badan ayay noo samaysay.","Ilmuhu wax xun ma samayn.","Waxaannu samaynay wax kasta oo suurtagal ah.","Buuqa maxaad ka samayseen?","Beerta wax badan ayay u sameeyeen.","Runtii taas ma samaysay?"]],
"überweisen":[["Maanta ayaan wareejinayaa kirada.","Lacagta ma ii wareejinaysaa?","Isagu lacagta waqtigeeda uma wareejiyo.","Bil kasta waxay wareejisaa 50 yuuro.","Xafiisku wuxuu bixiyaa lacagta carruurta.","Biilka online ayaannu ku bixinnaa.","Berri ma wareejinaysaan lacagta?","Dhammaadka bisha waxay bixiyaan kirada.","Fadlan wareeji 20 yuuro."],["Lacagta waan kuu wareejiyay.","Kirada ma wareejisay?","Isagu biilka ma bixin.","Shalay waxay wareejisay 100 yuuro.","Xafiisku wuxuu wareejiyay mushaharka.","Khidmadda horeba waannu bixinnay.","Lacagta ma wareejiseen?","Kirada online ayay ku bixiyeen.","Qaddarka lacagta ma wareejisay?"]],
"umsteigen":[["Saldhigga weyn ayaan tareenka ku beddelaa.","Xaggee ayaad gaadiidka ku beddeshaa?","Isagu maanta ma beddelayo tareenka.","Köln ayay ka raacaysaa tareenka ICE.","Kooxdu Hamburg ayay tareenka ku beddeshaa.","Waxaannu u wareegaynaa tareenka dhulka hoose.","Frankfurt ma ku beddelaysaan?","Jidka laba jeer ayay beddelaan.","Fadlan Mainz ku beddel."],["Munich ayaan tareenka ku beddelay.","Köln ma ku beddeshay?","Isagu tareenka ma beddelin.","Saldhigga si dhakhso ah ayay u beddeshay.","Kooxdu Berlin ayay ku beddeshay.","Laba jeer ayaannu beddelnay.","Xaggee ayaad ku beddesheen?","Basel ayay ku beddeleen.","Leipzig ma ku beddeshay?"]],
"umziehen":[["Toddobaadka soo socda ayaan guurayaa.","Goorma ayaad guuraysaa?","Isagu sannadkan ma guurayo.","Bisha Maajo waxay u guuraysaa Berlin.","Xafiisku wuxuu u guurayaa magaalada.","Waxaannu u guuraynaa guri ka weyn.","Dhowaan ma guuraysaan?","Xagaaga waxay u guurayaan Köln.","Adiguna ma guuraysaa?"],["Bishii hore ayaan guuray.","Horeba ma guurtay?","Isagu weli ma guurin.","Bisha Juun waxay u guurtay Bonn.","Maqaaxidu waxay u guurtay magaalada qadiimiga ah.","Waxaannu u guurnay Berlin.","Goorma ayaad guurteen?","Sannad ka hor ayay guureen.","Marar badan ma guurtay?"]],
"unterschreiben":[["Waxaan saxeexayaa heshiiska.","Halkan ma ku saxeexaysaa?","Isagu weli ma saxeexayo taas.","Maanta waxay saxeexaysaa warqadda.","Ilmuhu qalin qori ayuu ku saxeexaa.","Waxaannu saxeexaynaa heshiiska kirada.","Foomka ma saxeexaysaan?","Berri waxay saxeexayaan wax walba.","Fadlan halkan ku saxeex."],["Heshiiska waan saxeexay.","Foomka ma saxeexday?","Isagu ma saxeexin.","Maanta wax walba way saxeexday.","Ilmuhu wuxuu saxeexay kaarka.","Horeba waannu saxeexnay.","Liiska ma saxeexdeen?","Shalay way saxeexeen.","Codsiga ma saxeexday?"]],
"vergessen":[["Inta badan furahayga waan illaawaa.","Weligaa wax ma illowdaa?","Isagu ma illaawo ballantiisa.","Had iyo jeer dalladdeeda way illowdaa.","Ilmuhu wuxuu illaawaa koofiyaddiisa.","Annagu ku illoobi mayno.","Layliga guriga ma illowdaan?","Inta badan waxay illaawaan waqtiga.","Baasaboorkaaga ha illoobin!"],["Boorsadayda ayaan illaaway.","Ballanta ma illowday?","Isagu ma illaawin dhalashadeeda.","Maanta telefoonkeeda ayay illowday.","Ilmuhu wuxuu illaaway jaakaddiisa.","Waqtiga ayaannu illownay.","Wax ma illowdeen?","Nasiib darro waxay illaaween tikidhka.","Muraayaddaada ma illowday?"]],
"verlieren":[["Inta badan gacmo-gashigayga waan lumiyaa.","Ma necbahay in lagaa badiyo?","Isagu weligiis dulqaadka ma lumiyo.","Teniska iyada marar dhif ah ayaa laga badiyaa.","Kooxda ciyaarta waa laga badinayaa.","Annagu waqti ma luminno.","Turubka inta badan ma guuldarraysataan?","Kaynta dhexdeeda jidka ayay ka lumaan.","Ha quusan!"],["Boorsadayda lacagta ayaan lumiyay.","Telefoonkaaga ma lumisay?","Ciyaarta isaga lagama badin.","Baska ayay ku lumisay shaalkeeda.","Ilmaha ilig ayaa ka dhacay.","Waqti badan ayaannu luminnay.","Jidka ma ka lunteen?","Nasiib darro finalka waa laga badiyay.","Wax ma lumisay?"]],
"verstehen":[["Hadda hawsha waan fahamsanahay.","Ma i fahmaysaa?","Isagu af Ingiriis ma fahmo.","Telefoonka iyadu ima fahanto.","Ilmuhu horeba wax badan ayuu fahmaa.","Macallinka si fiican ayaannu u fahannaa.","Dhibaatada ma fahmaysaan?","Eray la'aan way isfahmaan.","Af Jarmal ma fahantaa?"],["Wax walba waan fahmay.","Su'aasha ma fahantay?","Isagu kaftanka ma fahmin.","Isla markiiba waxay fahantay xeerka.","Ilmuhu wuxuu fahmay sheekada.","Wax yar oo keliya ayaannu fahannay.","Layliga ma fahanteen?","Ugu dambayn waxay fahmeen ciyaarta.","Magacayga ma fahantay?"]],
"wehtun":[["Madaxu wuu i xanuunayaa.","Calooshu ma ku xanuunaysaa?","Dhabarku isaga ma xanuunayo.","Maanta iligga ayaa iyada xanuunaya.","Canugga calooshiisa ayaa xanuunaysa.","Cagaha ayaa na xanuunaya.","Lugaha ma idin xanuunayaan?","Jimicsiga kadib jirkooda oo dhan ayaa xanuunaya.","Maxaa ku xanuunaya?"],["Iliggu aad buu ii xanuunay.","Irbaddu ma ku xanuujisay?","Jilibkiisu ma xanuunin.","Shalay madaxa ayaa iyada xanuunay.","Ilmaha calooshiisa ayaa xanuuntay.","Kabaha ayaa na xanuujiyay.","Dhabarku ma idin xanuunay?","Gacmahooda ayaa xanuunay.","Xaggee ayaa ku xanuunay?"]],
"werden":[["Dhowaan waxaan noqonayaa soddon jir.","Ma noqonaysaa macallimad?","Bisha Maajo wuxuu noqonayaa aabbe.","Dhowaan waxay noqonaysaa dhakhtarad xoolaad.","Berri cimiladu way fiicnaan doontaa.","Maanta ma dhammaynayno.","Jiilaalka inta badan ma xanuunsataan?","Dayrta waxay noqonayaan waalid.","Ma noqonaysaa dhakhtar?"],["Waxaan noqday dhakhtar xoolaad.","Ma xanuunsatay?","Isagu ma daalin.","Sannadkii hore waxay noqotay hooyo.","Cimiladu way qabowday.","Waxaannu noqonnay saaxiibbo wanaagsan.","Roobku ma idin qooyay?","Waqti kadib way degganaadeen.","Ma noqotay macallin?"]],
"wissen":[["Jawaabta waan ogahay.","Ma og tahay meesha saldhiggu yaal?","Isagu ma oga saacadda ay tahay.","Dabcan taas way og tahay.","Ilmuhu horeba wax badan buu yaqaan.","Jidka waannu naqaan.","Ma og tihiin goorta koorsadu bilaabmayso?","Nasiib darro iyagu weli ma oga.","Ma og tahay saacadda ay tahay?"],["Aniga taas ma ogayn.","Taas ma ogayd?","Wuu ogaa jawaabta.","Dabcan wax walba way ogayd.","Ilmuhu jidka wuu yiqiin.","Waqti dheer ayaannu ogayn.","Taas ma ogaydeen?","Ka hor iyagu waxba ma ogayn.","Taas ma ogayd?"]],
"ziehen":[["Xadhigga ayaan jiidayaa.","Ma u guuraysaa Berlin?","Isagu uma guurayo magaalada.","Bisha Maajo waxay u guuraysaa Munich.","Farasku wuxuu jiidayaa gaariga.","Waxaannu u guuraynaa miyiga.","Waalidkiinna ma u guuraysaan?","Xagaaga waxay u guurayaan badda agteeda.","Fadlan si adag u jiid!"],["Waxaan u guuray Berlin.","Ma u guurtay guri la wadaago?","Isagu uma guurin Vienna.","Sannadkii hore waxay u guurtay Rooma.","Lammaanuhu waxay u guureen guri.","Waxaannu u guurnay miyiga.","Xaggee ayaad u guurteen?","Gu'ga waxay u guureen badda agteeda.","Ma u guurtay magaalada?"]],
"zurückgeben":[["Buugga ayaan kuu celinayaa.","Dalladda ma ii soo celinaysaa?","Isagu lacagta ma celiyo.","Berri waxay celinaysaa furaha.","Ilmuhu wuxuu celiyaa kubadda.","Maanta waxaannu celinaynaa buugaagta.","Baaskiillada ma celinaysaan?","Isniinta waxay celinayaan baabuurka.","Fadlan baasaboorka ii soo celi."],["Dalladda waan celiyay.","Buugga ma celisay?","Isagu lacagta ma celin.","Shalay waxay celisay DVD-ga.","Ilmuhu wuxuu celiyay kubadda.","Waxaannu celinnay furayaasha.","Baabuurka ma celiseen?","Waqtigii ayay wax walba ku celiyeen.","Jaakadda ma celisay?"]],
"zurückgehen":[["Si dhakhso ah ayaan guriga dib ugu noqonayaa.","Dukaanka ma dib ugu noqonaysaa?","Isagu xafiiska dib uguma noqonayo.","Hadda waxay dib ugu noqonaysaa baabuurka.","Ilmuhu dugsiga ayuu dib ugu noqdaa.","Waxaannu dib ugu noqonaynaa hoteelka.","Lugta ma dib ugu noqonaysaan?","Fiidka waxay dib ugu noqdaan tuulada.","Fadlan dib u noqo."],["Lug ayaan dib ugu noqday.","Keligaa ma dib u noqotay?","Isagu dib uma noqon.","Koorsada kadib dib ayay u noqotay.","Ilmuhu guriga ayuu dib ugu noqday.","Si dhakhso ah ayaannu dib ugu noqonnay.","Hoteelka ma dib ugu noqoteen?","Mar dambe ayay dib u noqdeen.","Baabuurka ma dib ugu noqotay?"]],
"zurückfahren":[["Berri guriga ayaan dib ugu noqonayaa.","Goorma ayaad dib u noqonaysaa?","Isagu maanta dib uma noqonayo.","Bas ayay dib ugu noqotaa.","Taksigu isagoo madhan ayuu dib u noqonayaa.","Tareen ayaannu dib ugu noqonaynaa.","Axadda ma dib u noqonaysaan?","Fasaxa kadib dib ayay u noqdaan.","Fadlan si tartiib ah dib ugu noqo."],["Baabuur ayaan dib ugu noqday.","Shalay ma dib u noqotay?","Isagu dib uma soo noqon.","Fiidkii ayay dib u noqotay.","Taksigu dib buu u noqday.","Baaskiil ayaannu dib ugu noqonnay.","Tareen ma dib ugu noqoteen?","Goor dambe ayay guriga dib ugu noqdeen.","Horeba ma dib u noqotay?"]],
"zurückkommen":[["Saacadda 6-da ayaan soo noqonayaa.","Goorma ayaad soo noqonaysaa?","Isagu maanta ma soo noqonayo.","Berri waxay ka soo noqonaysaa Baariis.","Ilmuhu wuxuu ka soo noqdaa dugsiga.","Dhowaan ayaannu soo noqonaynaa.","Isniinta ma soo noqonaysaan?","Bisha Ogosto ayay soo noqonayaan.","Fadlan berri soo noqo."],["Shalay ayaan soo noqday.","Si nabad ah ma u soo noqotay?","Isagu ma soo noqon.","Goor dambe ayay guriga u soo noqotay.","Baakaddu way soo noqotay.","Fasaxa ayaannu ka soo noqonnay.","Horeba ma soo noqoteen?","Fiidkii ayay soo noqdeen.","Si nabad ah ma u soo noqotay?"]]
}
