{
"abfahren":[["Saat sekizde yola çıkıyorum.","Yarın ne zaman yola çıkıyorsun?","O bugün yola çıkmıyor.","O pazartesi erken yola çıkıyor.","Taksi şimdi hareket ediyor.","Cumartesi yola çıkıyoruz.","Bu akşam yola çıkıyor musunuz?","Saat dokuzda yola çıkıyorlar.","Hangi perondan hareket ediyorsunuz?"],["Trenle yola çıktım.","Zamanında yola çıktın mı?","O bugün ne zaman yola çıktı?","Dün o saat yedide yola çıktı.","Gemi saat onda kalktı.","Henüz yola çıkmadık.","Pazar günü yola çıktınız mı?","Bu sabah yola çıktılar.","Köln'den ne zaman yola çıktınız?"]],
"abgeben":[["Bugün ödevleri teslim ediyorum.","Anahtarı teslim ediyor musun?","O kitabı yarın teslim ediyor.","O mektubu ne zaman teslim ediyor?","Çocuk defteri teslim ediyor.","Testi henüz teslim etmiyoruz.","Formu bugün teslim ediyor musunuz?","Cuma günü kitapları teslim ediyorlar.","Bavulu nerede teslim ediyorsunuz?"],["Paketi çoktan teslim ettim.","Testi teslim ettin mi?","O defteri teslim etmedi.","Dün o sınav kâğıdını teslim etti.","Çocuk resmi teslim etti.","Arabayı pazartesi teslim ettik.","Ceketleri nereye bıraktınız?","Köpeği büyükanneye bıraktılar mı?","Kimliğinizi teslim ettiniz mi?"]],
"anbieten":[["Sana bir kahve ikram ediyorum.","Büyükannene bir çay ikram ediyor musun?","O bize pasta ikram ediyor.","Bugün o misafirlere meyve suyu ikram ediyor.","Kafe kahvaltı sunmuyor.","Çocuklara ne ikram ediyoruz?","Max'e bir bardak su ikram ediyorsunuz.","Yazın dondurma sunuyorlar.","Almanca kursları da sunuyor musunuz?"],["Anna'ya pizza ikram ettim.","Dedene bir sandalye teklif ettin mi?","O bana oturacak yer teklif etti.","Dün o bize meyve ikram etti.","Otel bize bir oda teklif etti.","Tom'a çorba ikram etmedik.","Lena'ya bir şey ikram ettiniz mi?","Hemen bize yardım teklif ettiler.","Misafirinize ne ikram ettiniz?"]],
"anfangen":[["Bugün Almancaya başlıyorum.","İşe ne zaman başlıyorsun?","O hep zamanında başlıyor.","O pazartesi okula başlıyor.","Konser saat sekizde başlıyor.","Henüz başlamıyoruz.","Şimdi yemeğe başlıyor musunuz?","Haziranda bir kursa başlıyorlar.","Pazartesi bizde işe başlıyor musunuz?"],["Kitaba dün başladım.","Çoktan başladın mı?","O futbola başladı.","Dün o erken başladı.","Maç zamanında başladı.","Mayısta başladık.","Neden başlamadınız?","Bir hafta önce başladılar.","Burada ne zaman başladınız?"]],
"ankommen":[["Saat onda Berlin'e varıyorum.","Eve ne zaman varıyorsun?","O hep geç geliyor.","O yarın trenle mi geliyor?","Paket cuma günü geliyor.","İstasyona tam zamanında varıyoruz.","Saat sekizden önce varmıyorsunuz.","Akşam otele varıyorlar.","Saat kaçta varıyorsunuz?"],["Viyana'ya sağ salim vardım.","Dün ne zaman vardın?","O henüz gelmedi.","O pazar günü geldi.","Taksi çoktan geldi.","Saat on birde vardık.","Sağ salim vardınız mı?","Dün akşam vardılar.","Otobüsle mi geldiniz?"]],
"anrufen":[["Bu akşam seni ararım.","Yarın büyükanneyi arıyor musun?","O annesini sık sık arıyor.","O her gün babasını arıyor.","Çocuk annesini arıyor.","Neden doktoru aramıyoruz?","Pazar günü bizi arıyorsunuz.","Yarın okulu arıyorlar.","Pazartesi beni arar mısınız?"],["Dün Lena'yı aradım.","Kimi aradın?","O beni aramadı.","Bu sabah o dedesini aradı.","Hastane bizi aradı.","Oteli aradık.","Tom'u aradınız mı?","Dün üç kez aradılar.","Bugün beni aradınız mı?"]],
"anziehen":[["Kalın bir kazak giyiyorum.","Yarın ne giyiyorsun?","O ceket giymiyor.","Yarın o bir elbise giyiyor.","Çocuk ayakkabılarını giyiyor.","Kışın eldiven giyiyoruz.","Paltolarınızı giyiyor musunuz?","Bugün kot pantolon giyiyorlar.","Bugün takım elbise giyiyor musunuz?"],["Hızlıca giyindim.","Bere taktın mı?","O yeni gömleği giydi.","Dün o çorap giymedi.","Çocuk tek başına giyindi.","Kalın kıyafetler giydik.","Partiye ne giydiniz?","Bugün çizme giydiler.","Hangi ayakkabıları giydiniz?"]],
"aufstehen":[["Her gün saat altıda kalkıyorum.","Pazar günü ne zaman kalkıyorsun?","O kalkmayı sevmiyor.","Bugün o saat beşte kalkıyor.","Çocuk geceleri sık sık kalkıyor.","Hafta sonu geç kalkıyoruz.","Artık kalkıyor musunuz?","Yazın çok erken kalkıyorlar.","Cumartesi de erken kalkıyor musunuz?"],["Maalesef çok geç kalktım.","Kalktın mı artık?","O altı buçukta kalktı.","Bugün o yataktan kalkmadı.","Kız hemen kalktı.","Saat dörtte kalktık.","Neden bu kadar erken kalktınız?","Dün öğlen kalktılar.","Saat kaçta kalktınız?"]],
"aussehen":[["İyi görünüyor muyum?","Bugün çok güzel görünüyorsun.","O babasına benziyor.","Bugün o çok yorgun görünüyor.","Yemek lezzetli görünüyor.","Kardeş gibi görünmüyoruz.","Neden bu kadar üzgün görünüyorsunuz?","Birlikte çok mutlu görünüyorlar.","Bugün çok iyi görünüyorsunuz."],["Fotoğrafta yaşlı görünüyordum.","Çocukken nasıl görünüyordun?","O biraz hasta görünüyordu.","Dün o iyi görünmüyordu.","Oda harika görünüyordu.","Turist gibi görünüyorduk.","Eskiden farklı mı görünüyordunuz?","Akşam yorgun görünüyorlardı.","Gözlükle daha genç görünüyordunuz."]],
"aussteigen":[["Okulun önünde iniyorum.","Nerede iniyorsun?","Belediye binasının önünde iniyor.","Yarın Berlin'de iniyor.","Çocuk arkadan iniyor.","Burada inmiyoruz.","Şimdi iniyor musunuz?","Saat sekizde iniyorlar.","Merkez garda mı iniyorsunuz?"],["Henüz inmedim.","Çok erken mi indin?","Pazar meydanında indi.","Dün Köln'de indi.","Kız önden indi.","Havalimanında indik.","Nerede indiniz?","Pazar günü burada indiler.","Taksiden indiniz mi?"]],
"ausziehen":[["Henüz evden taşınmıyorum.","Ne zaman taşınıyorsun?","Ailesinin evinden taşınıyor.","Gelecek hafta taşınıyor.","Çift yazın taşınıyor.","Cumartesi günü taşınıyoruz.","Yakında taşınıyor musunuz?","Neden taşınıyorlar?","Mayısta mı taşınıyorsunuz?"],["Geçen yıl evden taşındım.","Taşındın mı artık?","Büyükannesinin evinden taşındı.","Dün taşındı.","Kız 18 yaşında evden ayrıldı.","Taşınmadık.","Cuma günü mü taşındınız?","Ne zaman taşındılar?","Geçen hafta mı taşındınız?"]],
"beginnen":[["Yarın yeni bir işe başlıyorum.","Kursa ne zaman başlıyorsun?","Güne kahveyle başlıyor.","Şimdi ödevlerine başlıyor.","Konser saat 20'de başlıyor.","Bugün başlamıyoruz.","Şimdiden başlıyor musunuz?","Saat dokuzda derse başlıyorlar.","Pazartesi mi başlıyorsunuz?"],["Henüz başlamadım.","Yemeğe başladın mı?","Saat yedide başladı.","Bugün yemek yapmaya başladı.","Maç çoktan başladı.","Ocakta başladık.","Ne zaman başladınız?","Zamanında başladılar mı?","Almancaya ne zaman başladınız?"]],
"bekommen":[["Bugün bir paket alıyorum.","Doğum gününde ne hediye alıyorsun?","Cevap alamıyor.","Yarın bir bisiklet alıyor.","Bebek süt alıyor.","Sık sık misafirimiz geliyor.","Çok ödev alıyor musunuz?","Bugün onlara posta geliyor mu?","Ne alırsınız?"],["Bir e-posta aldım.","Mektubumu aldın mı?","Dün bir hediye aldı.","İyi bir not aldı mı?","Çocuk bir dondurma aldı.","Bilet alamadık.","Noel'de ne hediye aldınız?","Mayısta bebekleri oldu.","Faturayı aldınız mı?"]],
"bleiben":[["Bugün evde kalıyorum.","Ne kadar kalıyorsun?","İki hafta Hamburg'da kalıyor.","Pazar günü yatakta kalıyor.","Pencere açık kalıyor.","Uzun kalmıyoruz.","Yemeğe kalıyor musunuz?","Bugün büyükannelerinde kalıyorlar.","Biraz daha kalır mısınız?"],["Bugün ofiste kaldım.","Partide uzun kaldın mı?","Neden kalmadı?","Dün Anna'da kaldı.","Kafe kapalı kaldı.","Roma'da üç gün kaldık.","Sonuna kadar kaldınız mı?","Akşam bizde kaldılar.","Otelde mi kaldınız?"]],
"bringen":[["Sana bir kahve getiriyorum.","Çocukları okula götürüyor musun?","Büyükannesine çiçek götürüyor.","Bugün bir pasta getiriyor.","Taksi bizi gara götürüyor.","Bugün içecek getirmiyoruz.","Partiye ne getiriyorsunuz?","Pazartesi kanepeyi getiriyorlar.","Bana bir su getirir misiniz lütfen?"],["Küçük ekmekler getirdim.","Kitabı getirdin mi?","Beni eve bıraktı.","Paketi postaneye götürdü mü?","Çocuk bir resim getirdi.","Hediye getirmedik.","Çocukları yatırdınız mı?","Bugün pizza getirdiler.","Arabayı nereye götürdünüz?"]],
"denken":[["Sık sık büyükannemi düşünüyorum.","Kimi düşünüyorsun?","Sadece futbolu düşünüyor.","Her gün ailesini düşünüyor.","Çocuk Noel'i düşünüyor.","Tatili düşünüyoruz.","Ödevleri hatırlıyor musunuz?","Bugün işi düşünmüyorlar.","Çocuklarınızı sık sık düşünüyor musunuz?"],["Seni düşündüm.","Sütü hatırladın mı?","Randevuyu hatırlamadı.","Dün babasını düşündü.","Kız her şeyi düşündü.","Sizi çok düşündük.","Biletleri hatırladınız mı?","Ne düşündüler?","Pasaportunuzu hatırladınız mı?"]],
"einladen":[["Seni yemeğe davet ediyorum.","Partiye kimi davet ediyorsun?","Arkadaşlarını davet ediyor.","Bugün Anna'yı kahveye davet ediyor.","Çocuk beş arkadaşını davet ediyor.","Max'i davet etmiyoruz.","Lena'yı da davet ediyor musunuz?","Cumartesi günü komşuları davet ediyorlar.","İş arkadaşlarınızı davet ediyor musunuz?"],["Bütün sınıfı davet ettim.","Tom'u davet ettin mi?","Beni sinemaya davet etti.","Dün bizi davet etti.","Kız dedesini davet etti.","Çok kişi davet etmedik.","Kimi davet ettiniz?","Seni de davet ettiler mi?","Ailenizi davet ettiniz mi?"]],
"empfehlen":[["Sana çorbayı tavsiye ediyorum.","Bana ne tavsiye edersin?","Restoranı tavsiye etmiyor.","Bugün balığı tavsiye ediyor.","Otel taksi tavsiye ediyor.","Pazar yerindeki kafeyi tavsiye ediyoruz.","Filmi tavsiye ediyor musunuz?","Treni tavsiye ediyorlar mı?","Bugün ne tavsiye edersiniz?"],["Anna'ya bir doktor tavsiye ettim.","Bana kitabı tavsiye ettin mi?","Bize pizzayı tavsiye etti.","Dün bana çay tavsiye etti.","Seyahat acentesi Roma'yı tavsiye etti.","Sinemayı tavsiye etmedik.","Max'e ne tavsiye ettiniz?","Sana kursu tavsiye ettiler mi?","Hangi oteli tavsiye ettiniz?"]],
"essen":[["Makarna yemeyi seviyorum.","Kahvaltıda ne yiyorsun?","Et yemiyor.","Öğle yemeğini kantinde yiyor.","Bebek muz yemeyi seviyor.","Pazar günü büyükannemde yemek yiyoruz.","Bugün restoranda mı yiyorsunuz?","Akşamları sık sık pizza yiyorlar.","Balık sever misiniz?"],["Çok fazla çikolata yedim.","Yemek yedin mi?","Bir elma yedi.","Dün çorba içti.","Çocuk hiç sebze yemedi.","Parkta yemek yedik.","Dün ne yediniz?","Bütün pastayı yediler mi?","Yemeğinizi beğendiniz mi?"]],
"fahren":[["Bugün otobüsle gidiyorum.","Yarın Berlin'e gidiyor musun?","Pazartesi işe gidiyor.","O sık sık bisikletle gider mi?","Taksi istasyona gidiyor.","Hafta sonu denize gidiyoruz.","Ne zaman eve gidiyorsunuz?","Bugün şehre gitmiyorlar.","Metroyla mı gidiyorsunuz?"],["Taksiyle gitmedim.","Trenle mi gittin?","Geçen hafta büyükannesine gitti.","Okula yalnız mı gitti?","Çocuk bisikletle gitti.","Pazar günü göle gittik.","Tatilde nereye gittiniz?","Akşam eve gittiler.","Dün Viyana'ya gittiniz mi?"]],
"finden":[["Anahtarımı bulamıyorum.","Kitabı nasıl buluyorsun?","Daireyi çok pahalı buluyor.","Filmi iyi buluyor mu?","Çocuk bir euro buluyor.","Bugün park yeri bulamıyoruz.","Almancayı zor buluyor musunuz?","Parkta bir kedi buluyorlar.","İstasyonun yolunu bulabiliyor musunuz?"],["Bir daire buldum.","Gözlüğünü buldun mu?","Sonunda bir iş buldu.","Otobüste bir cep telefonu buldu.","Kız kediyi buldu.","Oteli bulamadık.","Köpeği nerede buldunuz?","Pazartesi parayı buldular.","Pasaportunuzu buldunuz mu?"]],
"fliegen":[["Yazın İspanya'ya uçuyorum.","Tatilde nereye uçuyorsun?","Yarın Paris'e uçuyor.","Bugün Londra'ya mı uçuyor?","Uçak saat sekizde kalkıyor.","Uçmayı sevmiyoruz.","Cuma günü Viyana'ya mı uçuyorsunuz?","Kışın İtalya'ya uçuyorlar.","Sık sık Berlin'e uçar mısınız?"],["Dün Hamburg'a uçtum.","Hiç uçağa bindin mi?","Mayısta Kanada'ya uçtu.","Dün Madrid'e uçtu.","Uçak Kahire'ye uçtu.","Bu yıl uçakla seyahat etmedik.","Ne zaman eve uçtunuz?","Berlin'e birlikte mi uçtular?","Uçuşunuz ne kadar sürdü?"]],
"geben":[["Telefonumu sana vermiyorum.","Tuzu bana verir misin lütfen?","Çocuğa bir elma veriyor.","Bugün bir parti veriyor.","Burada bir süpermarket var mı?","Çiçekleri büyükanneye veriyoruz.","Doğum gününde Max'e ne veriyorsunuz?","Yarın bir konser veriyorlar.","Bana çok fazla para veriyorsunuz."],["Anneme bir hediye verdim.","Tom'a numaranı verdin mi?","Dün bana hiç para vermedi.","Sana ne verdi?","Dün pizza vardı.","Köpeğe su verdik.","Defteri öğretmene verdiniz mi?","Kafede bize pasta verdiler.","Anahtarı kime verdiniz?"]],
"gefallen":[["Şehri çok beğeniyorum.","Yeni daireyi beğeniyor musun?","Filmi beğenmiyor.","Kırmızı ayakkabıları beğeniyor.","Çocuk oyunu beğeniyor.","Parkı çok beğeniyoruz.","Berlin'i nasıl buluyorsunuz?","Artık okulu beğeniyorlar.","Müziği beğeniyor musunuz?"],["Tatili çok beğendim.","Konseri beğendin mi?","Partiyi çok beğendi.","Hediyeyi beğendi mi?","Çocuk kitabı beğendi.","Oteli beğenmedik.","Geziyi nasıl buldunuz?","Dün hayvanat bahçesini çok beğendiler.","Yemeği beğendiniz mi?"]],
"gehen":[["Bugün sinemaya gidiyorum.","Yarın okula gidiyor musun?","Saat onda yatıyor.","Bugün işe gitmiyor.","Nasılsın?","Cumartesi alışverişe gidiyoruz.","Sık sık parka gider misiniz?","Akşam restorana gidiyorlar.","İstasyona yürüyerek mi gidiyorsunuz?"],["Dün doktora gittim.","Ne zaman eve gittin?","Partiye gitmedi.","Pazar günü yüzmeye gitti.","Çocuk bahçeye gitti.","Dün müzeye gittik.","Birlikte yürüyüşe mi çıktınız?","Sonra kafeye gittiler.","Alışverişe gittiniz mi?"]],
"gelten":[["Bilet benim için de geçerli.","Kart senin için de geçerli mi?","Kural onun için geçerli değil.","Çocuk fiyatı onun için geçerli.","Kural çocuk için de geçerli.","Biletler hepimiz için geçerli.","Sizin için hangi kurallar geçerli?","Onlar için başka fiyatlar geçerli.","Bu fiyat bugün sizin için de geçerli."],["Kural benim için de geçerliydi.","Bilet senin için geçerli miydi?","Kampanya onun için geçerli değildi.","Fiyat onun için de geçerli miydi?","Kart çocuk için geçerliydi.","Mayısta bilet bizim için geçerliydi.","Sizin için hangi fiyat geçerliydi?","Onlar için başka kurallar geçerliydi.","Kart sadece sizin için mi geçerliydi?"]],
"heißen":[["Benim adım Anna.","Adın ne?","Onun adı Max değil.","Artık soyadı Becker.","Bebeğin adı Tom.","Bizim adlarımız Max ve Lena.","Soyadınız ne?","İkisinin de adı Anna mı?","Adınız ne?"],["Eskiden soyadım Schmidt'ti.","Senin adın Tom değil miydi?","Onun adı neydi?","Mayısa kadar soyadı Wagner'di.","Kitabın adı neydi?","Adımız her zaman böyle değildi.","Eskiden soyadınız Müller miydi?","O zamanlar soyadları Meyer'di.","Eskiden adınız neydi?"]],
"herunterladen":[["Uygulamayı indiriyorum.","Fotoğrafı indiriyor musun?","Her gün müzik indiriyor.","Bugün bir film indiriyor.","Telefon fotoğrafları indiriyor.","Oyun indirmiyoruz.","Orada ne indiriyorsunuz?","Akşam resimleri indiriyorlar.","Bileti nereden indiriyorsunuz?"],["Kitabı indirdim.","Videoyu indirdin mi?","Bir sözlük indirdi.","Sefer tarifesini indirdi mi?","Çocuk bir oyun indirdi.","Hiç uygulama indirmedik.","Şarkıları indirdiniz mi?","Sonra uygulamayı indirdiler.","Fotoğrafları indirdiniz mi?"]],
"helfen":[["Mutfakta anneme yardım ediyorum.","Ödevlerimde bana yardım eder misin?","Cumartesi bahçede dedesine yardım ediyor.","Bugün komşusuna yardım ediyor.","Çocuk yemek yapmaya yardım ediyor.","Sana seve seve yardım ediyoruz.","Tom'a neden yardım etmiyorsunuz?","Hafta sonu kafede yardım ediyorlar.","Bana gerçekten çok yardımcı oluyorsunuz."],["Temizlikte babama yardım ettim.","Dün kime yardım ettin?","Bana yardım etmedi.","Dün öğretmene yardım etti.","İlaç çabucak işe yaradı.","Komşulara yardım ettik.","Anna'ya bavul için yardım ettiniz mi?","Neyse ki bize yardım ettiler.","Annenize yardım ettiniz mi?"]],
"kennen":[["Öğretmeni iyi tanıyorum.","Kız kardeşimi tanıyor musun?","O, şehri tanımıyor.","O, istasyonun yolunu biliyor mu?","Çocuk birçok şarkı biliyor.","İyi bir restoran biliyoruz.","Tom'u nereden tanıyorsunuz?","Artık yeni öğretmeni tanıyorlar.","Bu sokağı biliyor musunuz?"],["Adamı tanımıyordum.","Bu şarkıyı zaten biliyor muydun?","O, bütün kelimeleri biliyordu.","O, filmi biliyor muydu?","Kız cevabı biliyordu.","Oteli iyi biliyorduk.","Yolu nereden biliyordunuz?","Burada birçok insanı tanıyorlardı.","Babamı tanıyor muydunuz?"]],
"kommen":[["Türkiye'den geliyorum.","Eve ne zaman geliyorsun?","O bugün işe gelmiyor.","O yarın otobüsle geliyor.","Bebek mayısta doğacak.","Saat sekizde geliyoruz.","Cumartesi partiye geliyor musunuz?","Pazar günü yemeğe geliyorlar.","Nerelisiniz?"],["Geç geldim.","İşe nasıl geldin?","O okula gelmedi.","O dün trenle geldi.","Paket bugün geldi.","Bisikletle geldik.","Eve sağ salim vardınız mı?","Saat dokuzda geldiler.","Berlin'e ne zaman geldiniz?"]],
"laufen":[["Her sabah parkta koşuyorum.","Okula yürüyerek mi gidiyorsun?","O çok hızlı koşuyor.","O pazar günü on kilometre koşuyor.","Bebek henüz yürümüyor.","Birlikte eve yürüyoruz.","Bu kadar hızlı nereye koşuyorsunuz?","Bugün süpermarkete yürüyerek gidiyorlar.","Ormanda koşmayı sever misiniz?"],["İstasyona yürüyerek gittim.","Bugün koşuya çıktın mı?","O dün koşmadı.","O nereye koştu?","Çocuk annesine koştu.","Şehirde yürüdük.","Göle kadar yürüdünüz mü?","Cumartesi parkta koştular.","Bugün işe yürüyerek mi gittiniz?"]],
"leidtun":[["Üzgünüm.","Ne için üzgünsün?","O buna gerçekten üzülüyor.","Şimdi o üzgün.","Çocuk buna üzülüyor.","Bunun için çok üzgünüz.","Buna üzülmüyor musunuz?","Onlar da buna üzülüyor.","Üzgün müsünüz?"],["Buna çok üzüldüm.","Üzülmedin mi?","O dün buna üzüldü.","O buna üzüldü mü?","Kız buna üzüldü.","Gerçekten üzüldük.","Neye üzüldünüz?","Onlar da buna üzüldü.","Buna üzüldünüz mü?"]],
"leihen":[["Sana bisikletimi ödünç veriyorum.","Kalemini bana ödünç verir misin?","O, Anna'ya telefonunu ödünç vermiyor.","O bugün Tom'a bir kitap ödünç veriyor.","Çocuk Lena'ya topunu ödünç veriyor.","Babama arabamızı ödünç veriyoruz.","Sandalyelerinizi bize ödünç verir misiniz?","Yarın anneme bir bavul ödünç veriyorlar.","Şemsiyenizi bana ödünç verir misiniz lütfen?"],["Max'e sözlüğümü ödünç verdim.","Fotoğraf makineni kime ödünç verdin?","O bana on avro ödünç verdi.","O sana ceketini ödünç verdi mi?","Kız bana bir oyun ödünç verdi.","Lena'ya hiç para ödünç vermedik.","Babama sırt çantasını ödünç verdiniz mi?","Dün bana kitap ödünç verdiler.","Ona parayı ödünç verdiniz mi?"]],
"lesen":[["Her akşam yatakta okuyorum.","Şu an ne okuyorsun?","O okumayı sevmiyor.","O sabahleyin e-postalarını okuyor.","Çocuk artık iyi okuyor.","Kursta bir metin okuyoruz.","Annemin mesajını okuyor musunuz?","Trende gazete okuyorlar.","Kitap okumayı sever misiniz?"],["Mektubu çoktan okudum.","Mesajımı okudun mu?","O, alıştırmayı okumadı.","O dün üç sayfa okudu.","Çocuk bir hikâye okudu.","Bütün kitabı okuduk.","Tatilde ne okudunuz?","Akşam uzun süre okudular.","E-postayı okudunuz mu?"]],
"liegen":[["Hastayım ve yatakta yatıyorum.","Neden yerde yatıyorsun?","O güneşte yatmayı sevmiyor.","O şimdi kanepede yatıyor.","Telefon masanın üstünde duruyor.","Pazar günü bahçede uzanıyoruz.","Plajda uzanmayı sever misiniz?","Yazın sık sık göl kenarında uzanıyorlar.","Rahat yatıyor musunuz?"],["Küvette uzandım.","Hastanede yattın mı?","O uzun süre yatakta yatmadı.","O uzun süre güneşte yattı mı?","Kitap nerede duruyordu?","Dün çimenlerde uzandık.","Balkonda uzandınız mı?","Tatilde deniz kenarında uzandılar.","Orada ne kadar yattınız?"]],
"mitbringen":[["Bir pasta getiriyorum.","Partiye ne getiriyorsun?","O bugün meyve suyu getirmiyor.","O yarın gitarını getiriyor.","Çocuk bir arkadaşını getiriyor.","Ekmek ve peynir getiriyoruz.","Çocuklarınızı da getiriyor musunuz?","Pazar günü çiçek getiriyorlar.","Köpeğinizi de getiriyor musunuz?"],["Sana bir şey getirdim.","Parayı getirdin mi?","O, küçük ekmekler getirdi.","O dün meyve getirdi.","Çocuk bir resim getirdi.","Hiç içecek getirmedik.","İtalya'dan ne getirdiniz?","Cuma günü salata getirdiler.","Kimliğinizi getirdiniz mi?"]],
"mitkommen":[["Seve seve geliyorum.","Sinemaya bizimle geliyor musun?","O maalesef bizimle gelmiyor.","Yarın o da geliyor.","Çocuk da doktora bizimle geliyor.","İstasyona sizinle geliyoruz.","Konsere bizimle geliyor musunuz?","Cumartesi pazara bizimle geliyorlar.","Bu akşam bizimle geliyor musunuz?"],["Seve seve geldim.","Müzeye sen de geldin mi?","O alışverişe bizimle geldi.","O dün sinemaya bizimle geldi.","Bebek de bizimle geldi.","Futbol maçına biz de geldik.","Hayvanat bahçesine siz de geldiniz mi?","Pazartesi bizimle gelmediler.","Şehre siz de geldiniz mi?"]]
}
