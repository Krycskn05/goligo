"stehen":[["Я стою на автобусній зупинці.","Чому ти тут стоїш?","Він не любить стояти в заторі.","В автобусі вона стоїть поруч зі мною.","Машина стоїть перед будинком.","Ми стоїмо біля каси.","Ви вже стоїте надворі?","Перед кінотеатром вони стоять у черзі.","Станьте, будь ласка, тут ліворуч."],["Я годину стояв у заторі.","Ти довго стояв біля каси?","Він не стояв біля вікна.","У поїзді вона весь час стояла.","Велосипед стояв перед дверима.","В автобусі ми стояли.","Де ви стояли?","Вони довго стояли біля входу.","Ви стояли в черзі?"]],
"stoßen":[["Я часто вдаряюся головою.","Чому ти мене штовхаєш?","Він не штовхає дитину.","Під час гри вона вдаряється об стіл.","Машина врізається в стіну.","Ми б'ємо м'яч головою.","Ви часто вдаряєтеся головою?","У тисняві вони штовхають інших людей.","Не вдартеся об шафу!"],["Я вдарився головою.","Ти вдарився коліном?","Він не вдарився.","Учора вона вдарилася об стіл.","Дитина вдарилася рукою.","Ми вдарилися об двері.","Ви вдарилися головою?","У темряві вони вдарилися.","Ви вдарилися?"]],
"tragen":[["Я несу важкий ящик.","Ти понесеш мою сумку?","Він не носить окулярів.","Сьогодні на ній червона сукня.","Дитина несе рюкзак.","Ми несемо стіл у кімнату.","Ви несете валізи?","Узимку вони носять теплі куртки.","Віднесіть, будь ласка, коробку нагору."],["Я ніс покупки.","Ти ніс валізу?","Він був без капелюха.","Учора вона була в сукні.","Дитина несла квіти.","Ми несли диван.","Ви віднесли ящики?","Вони довго носили малюка на руках.","Ви несли сумку?"]],
"treffen":[["Я зустрічаюся з подругою в кафе.","Ти сьогодні зустрічаєшся з Томом?","Він нечасто зустрічається з колегами.","Увечері вона зустрічається з батьками.","Команда збирається о десятій годині.","Ми зустрічаємося перед кінотеатром.","Коли ви зустрічаєтеся?","У парку вони зустрічають сусідів.","Ви завтра зустрічаєтеся з паном Кляйном?"],["Я зустрів Анну в автобусі.","Ти зустрів Тома?","Він не зустрівся з другом.","Учора вона зустріла свою вчительку.","Команда зустрілася в парку.","Ми зустрілися на вокзалі.","Де ви зустрілися?","Вони випадково зустріли Макса.","Ви зустріли пані Берг?"]],
"trinken":[["Я п'ю склянку води.","Ти п'єш каву чи чай?","Він не п'є алкоголю.","Уранці вона п'є апельсиновий сік.","Малюк п'є молоко.","Ми п'ємо чай з лимоном.","Що ви п'єте?","Влітку вони п'ють багато води.","Ви будете ще каву?"],["Я випив занадто мало води.","Ти вже пив каву?","Він не пив соку.","Учора вона випила багато чаю.","Дитина випила молоко.","Ми разом пили каву.","Що ви пили?","На вечірці вони пили колу.","Ви достатньо пили?"]],
"tun":[["Я охоче роблю це для тебе.","Що ти робиш сьогодні?","Сьогодні він робить мало.","Щодня вона робить щось добре.","Дитина робить усе для кішки.","Ми робимо все можливе.","Що ви робите на вихідних?","Вони багато роблять для довкілля.","Будь ласка, не робіть цього!"],["Сьогодні я багато зробив.","Що ти робив у неділю?","Він цього не робив.","Учора вона багато зробила для нас.","Дитина не зробила нічого поганого.","Ми зробили все можливе.","Що ви зробили проти шуму?","Вони багато зробили для саду.","Ви справді це зробили?"]],
"überweisen":[["Я сьогодні переказую плату за квартиру.","Ти перекажеш мені гроші?","Він переказує гроші не вчасно.","Щомісяця вона переказує 50 євро.","Установа перераховує допомогу на дитину.","Ми оплачуємо рахунок онлайн.","Ви завтра переказуєте гроші?","Наприкінці місяця вони переказують плату за квартиру.","Перекажіть, будь ласка, 20 євро."],["Я переказав тобі гроші.","Ти переказав плату за квартиру?","Він не оплатив рахунок.","Учора вона переказала 100 євро.","Офіс переказав зарплату.","Ми вже сплатили збір.","Ви переказали гроші?","Вони переказали плату за квартиру онлайн.","Ви переказали цю суму?"]],
"umsteigen":[["Я роблю пересадку на головному вокзалі.","Де ти робиш пересадку?","Сьогодні він не робить пересадки.","У Кельні вона пересідає на ICE.","Команда пересідає в Гамбурзі.","Ми пересідаємо на метро.","Ви пересідаєте у Франкфурті?","Дорогою вони двічі пересідають.","Будь ласка, зробіть пересадку в Майнці."],["Я пересів у Мюнхені.","Ти пересів у Кельні?","Він не пересів.","На вокзалі вона швидко пересіла.","Команда пересіла в Берліні.","Ми пересідали двічі.","Де ви пересіли?","У Базелі вони пересіли.","Ви пересіли в Лейпцигу?"]],
"umziehen":[["Я переїжджаю наступного тижня.","Коли ти переїжджаєш?","Цього року він не переїжджає.","У травні вона переїжджає до Берліна.","Офіс переїжджає в місто.","Ми переїжджаємо в більшу квартиру.","Ви скоро переїжджаєте?","Влітку вони переїжджають до Кельна.","Ви теж переїжджаєте?"],["Я переїхав минулого місяця.","Ти вже переїхав?","Він ще не переїхав.","У червні вона переїхала до Бонна.","Кафе переїхало в старе місто.","Ми переїхали до Берліна.","Коли ви переїхали?","Рік тому вони переїхали.","Ви часто переїжджали?"]],
"unterschreiben":[["Я підписую договір.","Ти розпишешся тут?","Він поки що цього не підписує.","Сьогодні вона підписує листа.","Дитина підписується олівцем.","Ми підписуємо договір оренди.","Ви підписуєте бланк?","Завтра вони підписують усі документи.","Розпишіться, будь ласка, тут."],["Я підписав договір.","Ти підписав бланк?","Він не підписав.","Сьогодні вона все підписала.","Дитина підписала листівку.","Ми вже підписали.","Ви підписали список?","Учора вони підписали.","Ви підписали заяву?"]],
"vergessen":[["Я часто забуваю ключ.","Ти ніколи нічого не забуваєш?","Він не забуває про свою зустріч.","Вона завжди забуває парасольку.","Дитина забуває шапку.","Ми тебе не забуваємо.","Ви забуваєте домашнє завдання?","Вони часто забувають про час.","Не забудьте свій паспорт!"],["Я забув сумку.","Ти забув про зустріч?","Він не забув про її день народження.","Сьогодні вона забула телефон.","Дитина забула куртку.","Ми забули про час.","Ви щось забули?","На жаль, вони забули квиток.","Ви забули свої окуляри?"]],
"verlieren":[["Я часто гублю рукавички.","Ти не любиш програвати?","Він ніколи не втрачає терпіння.","У теніс вона рідко програє.","Команда програє матч.","Ми не втрачаємо часу.","Ви часто програєте в карти?","У лісі вони збиваються з дороги.","Не падайте духом!"],["Я загубив гаманець.","Ти загубив телефон?","Він не програв гру.","В автобусі вона загубила шарф.","У дитини випав зуб.","Ми втратили багато часу.","Ви заблукали?","На жаль, вони програли фінал.","Ви щось загубили?"]],
"verstehen":[["Тепер я розумію завдання.","Ти мене розумієш?","Він не розуміє англійської.","По телефону вона мене не розуміє.","Дитина вже багато розуміє.","Ми добре розуміємо вчителя.","Ви розумієте проблему?","Вони розуміють одне одного без слів.","Ви розумієте німецьку?"],["Я все зрозумів.","Ти зрозумів питання?","Він не зрозумів жарту.","Вона одразу зрозуміла правило.","Дитина зрозуміла історію.","Ми зрозуміли зовсім мало.","Ви зрозуміли вправу?","Нарешті вони зрозуміли гру.","Ви зрозуміли моє ім'я?"]],
"wehtun":[["У мене болить голова.","У тебе болить живіт?","У нього не болить спина.","Сьогодні в неї болить зуб.","У малюка болить живіт.","У нас болять ноги.","У вас болять ноги?","Після спорту в них усе болить.","Що у Вас болить?"],["У мене сильно болів зуб.","Тобі було боляче від уколу?","Коліно в нього не боліло.","Учора в неї боліла голова.","У дитини болів живіт.","Нам тиснули черевики.","У вас боліла спина?","У них боліли руки.","Де у Вас боліло?"]],
"werden":[["Мені скоро тридцять.","Ти станеш учителькою?","У травні він стане батьком.","Незабаром вона стане ветеринаром.","Завтра буде гарна погода.","Сьогодні ми не закінчимо.","Ви часто хворієте взимку?","Восени вони стануть батьками.","Ви станете лікарем?"],["Я став ветеринаром.","Ти захворів?","Він не втомився.","Минулого року вона стала мамою.","Погода стала холодною.","Ми стали добрими друзями.","Ви промокли?","З часом вони стали спокійнішими.","Ви стали вчителем?"]],
"wissen":[["Я знаю відповідь.","Ти знаєш, де вокзал?","Він не знає, котра година.","Звичайно, вона це знає.","Дитина вже багато знає.","Ми знаємо дорогу.","Ви знаєте, коли починається курс?","На жаль, вони цього ще не знають.","Ви знаєте, котра година?"],["Я цього не знав.","Ти це знав?","Він знав відповідь.","Звичайно, вона все знала.","Дитина знала дорогу.","Ми давно це знали.","Ви це знали?","Раніше вони нічого не знали.","Ви це знали?"]],
"ziehen":[["Я тягну за мотузку.","Ти переїжджаєш до Берліна?","Він не переїжджає в місто.","У травні вона переїжджає до Мюнхена.","Кінь тягне віз.","Ми переїжджаємо в село.","Ви переїжджаєте до своїх батьків?","Влітку вони переїжджають до моря.","Тягніть, будь ласка, сильніше!"],["Я переїхав до Берліна.","Ти переїхав у квартиру із сусідами?","Він не переїхав до Відня.","Минулого року вона переїхала до Рима.","Пара переїхала в будинок.","Ми переїхали в село.","Куди ви переїхали?","Навесні вони переїхали до моря.","Ви переїхали в місто?"]],
"zurückgeben":[["Я повертаю тобі книжку.","Ти повернеш мені парасольку?","Він не повертає гроші.","Завтра вона повертає ключ.","Дитина повертає м'яч.","Сьогодні ми повертаємо книжки.","Ви повертаєте велосипеди?","У понеділок вони повертають машину.","Поверніть мені, будь ласка, паспорт."],["Я повернув парасольку.","Ти повернув книжку?","Він не повернув гроші.","Учора вона повернула DVD.","Дитина повернула м'яч.","Ми повернули ключі.","Ви повернули машину?","Вони повернули все вчасно.","Ви повернули куртку?"]],
"zurückgehen":[["Я швидко повертаюся додому.","Ти повертаєшся до магазину?","Він не повертається в офіс.","Зараз вона повертається до машини.","Дитина повертається до школи.","Ми повертаємося до готелю.","Ви повертаєтеся пішки?","Увечері вони повертаються в село.","Поверніться, будь ласка."],["Я повернувся пішки.","Ти повернувся сам?","Він не повернувся.","Після занять вона повернулася.","Дитина повернулася в будинок.","Ми швидко повернулися.","Ви повернулися до готелю?","Пізніше вони повернулися.","Ви повернулися до машини?"]],
"zurückfahren":[["Завтра я їду назад додому.","Коли ти їдеш назад?","Сьогодні він не їде назад.","Назад вона їде автобусом.","Таксі їде назад порожнім.","Назад ми їдемо поїздом.","Ви їдете назад у неділю?","Після відпустки вони їдуть назад.","Будь ласка, їдьте назад повільно."],["Я повернувся машиною.","Ти вчора повернувся?","Він не поїхав назад.","Увечері вона поїхала назад.","Таксі поїхало назад.","Ми повернулися велосипедом.","Ви повернулися поїздом?","Вони пізно повернулися додому.","Ви вже поїхали назад?"]],
"zurückkommen":[["Я повертаюся о шостій годині.","Коли ти повертаєшся?","Сьогодні він не повертається.","Завтра вона повертається з Парижа.","Дитина повертається зі школи.","Ми скоро повернемося.","Ви повертаєтеся в понеділок?","У серпні вони повертаються.","Приходьте, будь ласка, завтра."],["Я повернувся вчора.","Ти щасливо повернувся?","Він не повернувся.","Вона пізно повернулася додому.","Посилка повернулася.","Ми повернулися з відпустки.","Ви вже повернулися?","Увечері вони повернулися.","Ви щасливо повернулися?"]]
